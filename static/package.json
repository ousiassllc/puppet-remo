{
  "name": "puppet-remo-static",
  "version": "0.0.0",
  "private": true,
  "description": "puppet-remo のホスト GUI のフロントエンド（HTMX + Tailwind。docs/architecture/frontend.md §8）",
  "type": "module",
  "scripts": {
    "build": "bun run clean && bun run build:fonts && bun run build:css && bun run build:js && bun run copy:htmx",
    "clean": "bun scripts/clean.mjs",
    "build:fonts": "bun scripts/copy-fonts.mjs",
    "build:js": "bun esbuild.config.mjs",
    "build:css": "bun --bun tailwindcss -i src/css/app.css -o dist/css/app.css --minify",
    "copy:htmx": "bun scripts/copy-htmx.mjs",
    "test": "bun --bun web-test-runner",
    "e2e": "bun --bun playwright test",
    "dev": "bun --bun concurrently \"bun run dev:css\" \"bun run dev:js\"",
    "dev:css": "bun run build:fonts && bun --bun tailwindcss -i src/css/app.css -o dist/css/app.css --watch",
    "dev:js": "bun esbuild.config.mjs --watch"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/sora": "5.3.0",
    "@open-wc/testing": "5.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/mocha": "10.0.10",
    "@web/dev-server-esbuild": "2.0.0",
    "@web/test-runner": "1.0.0",
    "@web/test-runner-playwright": "1.0.0",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "htmx-ext-response-targets": "2.0.4",
    "htmx-ext-sse": "2.2.4",
    "htmx.org": "2.0.11",
    "lit": "3.3.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
