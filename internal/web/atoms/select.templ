package atoms

// SelectOption は選択肢 1 つ。
type SelectOption struct {
	Value    string
	Label    string
	Selected bool
}

// Select は選択欄。
templ Select(id, name string, options []SelectOption) {
	<select id={ id } name={ name } class={ fieldClass("h-10 px-3 ", false) }>
		for _, o := range options {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}
