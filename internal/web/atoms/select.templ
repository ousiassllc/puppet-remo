package atoms

// SelectOption は選択肢 1 つ。
type SelectOption struct {
	Value    string
	Label    string
	Selected bool
}

// Select は選択欄。
templ Select(id, name string, options []SelectOption) {
	<select id={ id } name={ name } class="block w-full rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
		for _, o := range options {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}
