package atoms

// SelectOption は選択肢 1 つ。
type SelectOption struct {
	Value    string
	Label    string
	Selected bool
}

// Select は選択欄。矢印は app.css の select（appearance: none + --mute の矢印）。右 padding 36 は矢印の分。
templ Select(id, name string, options []SelectOption) {
	<select id={ id } name={ name } class={ fieldClass("h-10 pl-3 pr-9 ", false) }>
		for _, o := range options {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}
