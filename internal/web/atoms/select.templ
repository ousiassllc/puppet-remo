package atoms

// SelectOption は選択肢 1 つ。
type SelectOption struct {
	Value    string
	Label    string
	Selected bool
}

// SelectProps は選択欄の引数。
type SelectProps struct {
	ID      string
	Name    string
	Options []SelectOption
	Invalid bool
	Attrs   Attrs
}

// Select は、エラーを持たない選択欄。エラーを FormField に渡す選択欄は SelectWith で Invalid を渡す。
templ Select(id, name string, options []SelectOption) {
	@SelectWith(SelectProps{ID: id, Name: name, Options: options})
}

// SelectWith は選択欄。矢印は app.css の select（appearance: none + --mute の Iconoir nav-arrow-down）。右 padding 36 は矢印の分。
templ SelectWith(p SelectProps) {
	<select id={ p.ID } name={ p.Name } class={ fieldClass("h-10 pl-3 pr-9 ", p.Invalid) } aria-invalid?={ p.Invalid } { describedAttrs(ctx, p.ID, p.Attrs)... }>
		for _, o := range p.Options {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}
