package atoms

// BadgeTone はバッジの色の種類。
type BadgeTone string

const (
	BadgeNeutral BadgeTone = "neutral"
	BadgeOK      BadgeTone = "ok"
	BadgeWarn    BadgeTone = "warn"
	BadgeDanger  BadgeTone = "danger"
	// BadgeSoft は --accent-soft 地に --mute-on-soft の文字（状態色を持たない短い注記。秘密の入力欄の「登録済み」）。
	BadgeSoft BadgeTone = "soft"
)

// badgeClass はステータスピル。状態色の細枠 + 薄い地 + 文言（色だけで意味を伝えない）。
func badgeClass(t BadgeTone) string {
	if t == BadgeSoft {
		return "inline-flex h-5.5 items-center whitespace-nowrap rounded-full bg-accent-soft px-2 text-xs leading-none text-mute-on-soft"
	}
	base := "inline-flex items-center gap-1 rounded-full border px-2 py-1 text-xs "
	switch t {
	case BadgeOK:
		return base + "border-success-line bg-success-wash text-success"
	case BadgeWarn:
		return base + "border-warning-line bg-warning-wash text-warning"
	case BadgeDanger:
		return base + "border-danger-line bg-danger-wash text-danger"
	default:
		return base + "border-border bg-accent-soft text-ink"
	}
}

// badgeIcon は状態のアイコン（色だけで意味を伝えない）。中立（種別・件数などの状態でない表示）には付けない。
func badgeIcon(t BadgeTone) (IconName, bool) {
	switch t {
	case BadgeOK:
		return IconCheckCircle, true
	case BadgeWarn:
		return IconWarningTriangle, true
	case BadgeDanger:
		return IconXmarkCircle, true
	default:
		return "", false
	}
}

// Badge は状態を示す小さなラベル。状態色の枠・アイコン・文言で伝える。
templ Badge(tone BadgeTone, text string) {
	<span class={ badgeClass(tone) }>
		if name, ok := badgeIcon(tone); ok {
			@Icon(name, IconSM)
		}
		{ text }
	</span>
}
