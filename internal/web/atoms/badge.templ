package atoms

// BadgeTone はバッジの色の種類。
type BadgeTone string

const (
	BadgeNeutral BadgeTone = "neutral"
	BadgeOK      BadgeTone = "ok"
	BadgeWarn    BadgeTone = "warn"
	BadgeDanger  BadgeTone = "danger"
)

// badgeClass はステータスピル。状態色の細枠 + 薄い地 + 文言（色だけで意味を伝えない）。
func badgeClass(t BadgeTone) string {
	base := "inline-flex items-center rounded-full border px-2 py-1 text-xs "
	switch t {
	case BadgeOK:
		return base + "border-success/40 bg-success/10 text-success"
	case BadgeWarn:
		return base + "border-warning/40 bg-warning/10 text-warning"
	case BadgeDanger:
		return base + "border-danger/40 bg-danger/10 text-danger"
	default:
		return base + "border-border bg-accent-soft text-ink"
	}
}

// Badge は状態を示す小さなラベル。
templ Badge(tone BadgeTone, text string) {
	<span class={ badgeClass(tone) }>{ text }</span>
}
