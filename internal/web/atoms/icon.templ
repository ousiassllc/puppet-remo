package atoms

// IconName は UI アイコンの名前。Iconoir（https://iconoir.com。MIT ライセンス）の regular（線の太さ 1.5・24px の格子）から、
// 使うものだけをここに取り込む。アイコンを足すときは、Iconoir の SVG の path の d をここへ写す（ガイド I1）。
type IconName string

const (
	IconXmark           IconName = "xmark"
	IconArrowLeft       IconName = "arrow-left"
	IconArrowRight      IconName = "arrow-right"
	IconCheckCircle     IconName = "check-circle"
	IconWarningTriangle IconName = "warning-triangle"
	IconInfoCircle      IconName = "info-circle"
	IconXmarkCircle     IconName = "xmark-circle"
	IconEmptyPage       IconName = "empty-page"
	IconMenu            IconName = "menu"
	IconEye             IconName = "eye"
	IconEyeClosed       IconName = "eye-closed"
)

// IconSize はアイコンの大きさ（ガイド I2）。sm 16 / md 20 / lg 24。xl 32 は空状態だけ。
type IconSize string

const (
	IconSM IconSize = "sm"
	IconMD IconSize = "md"
	IconLG IconSize = "lg"
	IconXL IconSize = "xl"
)

// iconPaths は Iconoir の SVG の path の d（regular）。
var iconPaths = map[IconName][]string{
	IconXmark:      {"M6.75827 17.2426L12.0009 12M17.2435 6.75736L12.0009 12M12.0009 12L6.75827 6.75736M12.0009 12L17.2435 17.2426"},
	IconArrowLeft:  {"M21 12L3 12M3 12L11.5 3.5M3 12L11.5 20.5"},
	IconArrowRight: {"M3 12L21 12M21 12L12.5 3.5M21 12L12.5 20.5"},
	IconMenu:       {"M3 5H21", "M3 12H21", "M3 19H21"},
	IconCheckCircle: {
		"M7 12.5L10 15.5L17 8.5",
		"M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z",
	},
	IconWarningTriangle: {
		"M20.0429 21H3.95705C2.41902 21 1.45658 19.3364 2.22324 18.0031L10.2662 4.01533C11.0352 2.67792 12.9648 2.67791 13.7338 4.01532L21.7768 18.0031C22.5434 19.3364 21.581 21 20.0429 21Z",
		"M12 9V13",
		"M12 17.01L12.01 16.9989",
	},
	IconInfoCircle: {
		"M12 11.5V16.5",
		"M12 7.51L12.01 7.49889",
		"M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z",
	},
	IconXmarkCircle: {
		"M9.17218 14.8284L12.0006 12M14.829 9.17157L12.0006 12M12.0006 12L9.17218 9.17157M12.0006 12L14.829 14.8284",
		"M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z",
	},
	IconEmptyPage: {
		"M4 21.4V2.6C4 2.26863 4.26863 2 4.6 2H16.2515C16.4106 2 16.5632 2.06321 16.6757 2.17574L19.8243 5.32426C19.9368 5.43679 20 5.5894 20 5.74853V21.4C20 21.7314 19.7314 22 19.4 22H4.6C4.26863 22 4 21.7314 4 21.4Z",
		"M16 2V5.4C16 5.73137 16.2686 6 16.6 6H20",
	},
	IconEye: {
		"M3 13C6.6 5 17.4 5 21 13",
		"M12 17C10.3431 17 9 15.6569 9 14C9 12.3431 10.3431 11 12 11C13.6569 11 15 12.3431 15 14C15 15.6569 13.6569 17 12 17Z",
	},
	IconEyeClosed: {
		"M19.5 16L17.0248 12.6038",
		"M12 17.5V14",
		"M4.5 16L6.96895 12.6124",
		"M3 8C6.6 16 17.4 16 21 8",
	},
}

func iconClass(s IconSize) string {
	base := "shrink-0 "
	switch s {
	case IconMD:
		return base + "size-5"
	case IconLG:
		return base + "size-6"
	case IconXL:
		return base + "size-8"
	default:
		return base + "size-4"
	}
}

// Icon は UI アイコン。色は currentColor（親の文字色）で、装飾なのでスクリーンリーダーには読ませない（意味は隣の文言が伝える）。
// インラインの <style> は使わず（CSP）、サイズはクラスで指定する。
templ Icon(name IconName, size IconSize) {
	<svg class={ iconClass(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		for _, d := range iconPaths[name] {
			<path d={ d }></path>
		}
	</svg>
}
