package atoms

// InputProps は入力欄の引数。
type InputProps struct {
	ID          string
	Name        string
	Type        string // text | number | password など。空なら text
	Value       string
	Placeholder string
	Required    bool
	Readonly    bool
	Invalid     bool
	Attrs       Attrs
}

func inputType(t string) string {
	if t == "" {
		return "text"
	}
	return t
}

func inputClass(invalid bool) string {
	return fieldClass("h-10 px-3 ", invalid)
}

// textareaClass は複数行の入力欄のクラス（高さは行数で決まるので、高さの指定は持たない）。
func textareaClass(invalid bool) string {
	return fieldClass("px-3 py-2 ", invalid)
}

// fieldClass は入力欄・選択欄・複数行の入力欄に共通のクラス。本文と同じ 16px・Regular。
func fieldClass(size string, invalid bool) string {
	base := "block w-full min-w-0 rounded-md border bg-surface text-base shadow-sm read-only:bg-bone " + size
	if invalid {
		return base + "border-danger"
	}
	return base + "border-border"
}

// Input は 1 行の入力欄。
templ Input(p InputProps) {
	<input
		id={ p.ID }
		name={ p.Name }
		type={ inputType(p.Type) }
		value={ p.Value }
		placeholder={ p.Placeholder }
		class={ inputClass(p.Invalid) }
		required?={ p.Required }
		readonly?={ p.Readonly }
		aria-invalid?={ p.Invalid }
		{ p.Attrs... }
	/>
}
