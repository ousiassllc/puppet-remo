package atoms

// ButtonVariant はボタンの見た目の種類。
type ButtonVariant string

const (
	ButtonPrimary   ButtonVariant = "primary"
	ButtonSecondary ButtonVariant = "secondary"
	ButtonDanger    ButtonVariant = "danger"
	ButtonGhost     ButtonVariant = "ghost"
)

// ButtonProps はボタンの引数。Type が空なら "button"（フォーム送信は "submit" を明示する）。
// Small は小ボタン（高さ 32・14px。一覧の行・カードの中の操作）で、既定は高さ 40・16px。
type ButtonProps struct {
	Label   string
	Variant ButtonVariant
	Type    string
	Small   bool
	Attrs   Attrs
}

func buttonType(t string) string {
	if t == "submit" {
		return "submit"
	}
	return "button"
}

// ButtonClass はボタンのクラス。ボタンの見た目にするリンク（<a>）が atoms.Button と同じ見た目になるように、公開している。
func ButtonClass(v ButtonVariant, small bool) string {
	if small {
		return buttonClass(v, "h-8 px-3 text-sm ")
	}
	return buttonClass(v, "h-10 px-4 text-base ")
}

// PagerButtonClass はページ送り（前へ・次へ）のクラス。ガイドのページネーション（P1）は高さ 36・rounded-md で、小ボタン（32）ではない。
func PagerButtonClass() string {
	return buttonClass(ButtonSecondary, "h-9 px-3 text-sm ")
}

func buttonClass(v ButtonVariant, size string) string {
	base := "motion-hover inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-md font-semibold disabled:opacity-40 " + size
	switch v {
	case ButtonDanger:
		return base + "border border-danger/45 bg-transparent text-danger hover:bg-danger/10"
	case ButtonGhost:
		return base + "bg-transparent text-ink hover:bg-accent-soft"
	case ButtonSecondary:
		return base + "border border-border bg-transparent text-ink hover:bg-accent-soft"
	default:
		return base + "bg-accent text-bone hover:bg-accent/90"
	}
}

// Button は操作ボタン。hx-* は Attrs で渡す。
templ Button(p ButtonProps) {
	<button type={ buttonType(p.Type) } class={ ButtonClass(p.Variant, p.Small) } data-ripple { p.Attrs... }>{ p.Label }</button>
}
