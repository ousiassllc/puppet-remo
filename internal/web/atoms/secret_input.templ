package atoms

// SecretInput は API キーなどの秘密の入力欄。伏せ字（type=password）で、value 属性を決して描画しない
// （登録済みの値も、再描画での入力の戻しも出さない。NFR-S14）。ブラウザの自動入力・補完・スペルチェックは止める。
// 入力文字は base 16（入力欄と同じ）。右の Eye / EyeClosed のアイコンボタンで入力中の値の表示を切り替える
// （type の切り替えは app.ts。data-secret-toggle）。aria-pressed が表示中かどうかを伝え、ラベルは固定にする
// （押下状態の切り替えでラベルも変えると、スクリーンリーダーが状態を二重に読む）。
templ SecretInput(id, name string, invalid bool) {
	<div class="flex items-center gap-2">
		<input
			id={ id }
			name={ name }
			type="password"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			class={ inputClass(invalid, false) }
			aria-invalid?={ invalid }
		/>
		<button
			type="button"
			class="group motion-hover inline-flex size-10 shrink-0 items-center justify-center rounded-md text-ink hover:bg-accent-soft"
			aria-label="入力を表示する"
			aria-pressed="false"
			aria-controls={ id }
			data-secret-toggle
			data-ripple
		>
			<span class="inline-flex group-aria-pressed:hidden">@Icon(IconEye, IconMD)</span>
			<span class="hidden group-aria-pressed:inline-flex">@Icon(IconEyeClosed, IconMD)</span>
		</button>
	</div>
}
