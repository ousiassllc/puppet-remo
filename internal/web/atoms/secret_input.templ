package atoms

// SecretInput は API キーなどの秘密の入力欄。伏せ字（type=password）で、value 属性を決して描画しない
// （登録済みの値も、再描画での入力の戻しも出さない。NFR-S14）。ブラウザの自動入力・補完・スペルチェックは止める。
templ SecretInput(id, name string, invalid bool) {
	<input
		id={ id }
		name={ name }
		type="password"
		autocomplete="off"
		autocapitalize="off"
		spellcheck="false"
		class={ inputClass(invalid, false) }
		aria-invalid?={ invalid }
	/>
}
