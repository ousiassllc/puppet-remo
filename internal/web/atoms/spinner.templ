package atoms

// Spinner は読み込み中の表示（20px の回転する円 + 文言）。hx-indicator の対象にする（.htmx-indicator は app.css が opacity で切り替える）。
templ Spinner(id string) {
	<span id={ id } class="htmx-indicator inline-flex items-center gap-2 text-sm text-mute" role="status">
		<span class="spinner" aria-hidden="true"></span>
		処理中…
	</span>
}
