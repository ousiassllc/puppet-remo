package atoms

// AlertTone はインラインアラートの種類（お知らせ・成功・注意・エラー）。
type AlertTone string

const (
	AlertInfo    AlertTone = "info"
	AlertSuccess AlertTone = "success"
	AlertWarning AlertTone = "warning"
	AlertDanger  AlertTone = "danger"
)

// AlertProps はインラインアラートの引数。Code は API 仕様 §2 のコードで、あれば data-error-code に出す。
// Dismissible は閉じるボタン（data-clear で #alert-root を空にする）を付けるとき。
type AlertProps struct {
	Tone        AlertTone
	Code        string
	Heading     string
	Message     string
	Dismissible bool
	// Template は app.ts が複製するための雛形（ページに常に置くので role は付けず、複製したときに app.ts が付ける）。
	Template bool
}

func alertClass(t AlertTone) string {
	base := "motion-rise-in flex items-start gap-3 rounded-md border px-4 py-3 text-sm "
	switch t {
	case AlertSuccess:
		return base + "border-success-line bg-success-wash text-success"
	case AlertWarning:
		return base + "border-warning-line bg-warning-wash text-warning"
	case AlertDanger:
		return base + "border-danger-line bg-danger-wash text-danger"
	default:
		return base + "border-info-line bg-info-wash text-info"
	}
}

func alertIcon(t AlertTone) IconName {
	switch t {
	case AlertSuccess:
		return IconCheckCircle
	case AlertWarning:
		return IconWarningTriangle
	case AlertDanger:
		return IconXmarkCircle
	default:
		return IconInfoCircle
	}
}

func alertAttrs(p AlertProps) Attrs {
	a := Attrs{"data-alert-tone": string(p.Tone)}
	if !p.Template {
		a["role"] = "alert"
	}
	if p.Code != "" {
		a["data-error-code"] = p.Code
	}
	return a
}

// Alert はインラインアラート。状態は色だけでなく題と本文でも伝える。ミドルウェアが拒否した状態変更のリクエスト
// （アクションルート）に返すエラーのフラグメントと、アクションの失敗の表示先（#alert-root）に使う。
// 題はガイドの「インラインアラートの題」（sm 14・SemiBold）。#alert-root はどの見出しの下にも出るので、題は見出しにせず強調テキストにする
// （h3 にすると h1 → h3 の飛びになる。role="alert" が読み上げを担う）。
templ Alert(p AlertProps) {
	<div class={ alertClass(p.Tone) } { alertAttrs(p)... }>
		@Icon(alertIcon(p.Tone), IconMD)
		<div class="min-w-0 flex-1">
			<strong class="block text-sm font-semibold">{ p.Heading }</strong>
			<p class="mt-2 text-ink" data-alert-message>{ p.Message }</p>
		</div>
		if p.Dismissible {
			<button type="button" class="motion-hover inline-flex size-8 shrink-0 items-center justify-center rounded-md text-mute hover:bg-accent-soft hover:text-ink" aria-label="閉じる" data-clear="#alert-root" data-ripple>
				@Icon(IconXmark, IconMD)
			</button>
		}
	</div>
}

// noticeClass は題なしインラインアラートの形（ガイド「設定画面のパーツ」3）。Alert と同形（角丸 --r-md・padding 12×16）で、
// 地は --surface・枠は --border 1px。状態色は左の線（3px）だけに使う。
func noticeClass(t AlertTone, animated bool) string {
	base := "flex items-start gap-3 rounded-md border border-border border-l-3 bg-surface px-4 py-3 text-sm text-ink "
	if animated {
		base = "motion-rise-in " + base
	}
	switch t {
	case AlertSuccess:
		return base + "border-l-success"
	case AlertWarning:
		return base + "border-l-warning"
	case AlertDanger:
		return base + "border-l-danger"
	default:
		return base + "border-l-info"
	}
}

func noticeIconClass(t AlertTone) string {
	// アイコンを 1 行目（text-sm・行間 1.7 ≒ 24px）の中央に合わせる（スケール外の 2px の余白で寄せず、行と同じ高さの箱の中央に置く）。
	base := "flex h-6 shrink-0 items-center "
	switch t {
	case AlertSuccess:
		return base + "text-success"
	case AlertWarning:
		return base + "text-warning"
	case AlertDanger:
		return base + "text-danger"
	default:
		return base + "text-info"
	}
}

// Notice は画面に常設する注意書き・同意の枠（題なしのインラインアラート）。題と閉じるボタンは持たず、
// アイコン（状態色）+ 文言（children。本文色 ink）+ 左の線（状態色）で伝える（色だけにしない）。
// 色の使い分けはガイドの 2 値: AlertWarning = データの扱い・取り消せないことなど、ずっと出しておく注意書き。
// AlertInfo = 同意のチェックを入れる枠・ただの補足。AlertDanger はエラーの表示（フォームのエラー・読めない設定）に限る。
// ページを開いたときから在るものなので、出現は静かに（アニメーションなし）。操作の結果として現れるものは NoticeAnimated。
// 操作の結果として返すエラーは Alert を使う。attrs には role・data-* を渡す。
templ Notice(tone AlertTone, attrs Attrs) {
	@notice(tone, attrs, false) {
		{ children... }
	}
}

// NoticeAnimated は操作の結果として現れる Notice（422 の再描画・アクションの応答・状態の切り替わり）。
// Alert・FormField のエラーと同じ出現（motion-rise-in。M5）にそろえる。
templ NoticeAnimated(tone AlertTone, attrs Attrs) {
	@notice(tone, attrs, true) {
		{ children... }
	}
}

templ notice(tone AlertTone, attrs Attrs, animated bool) {
	<div class={ noticeClass(tone, animated) } { attrs... }>
		<span class={ noticeIconClass(tone) }>
			@Icon(alertIcon(tone), IconSM)
		</span>
		<div class="min-w-0 flex-1 space-y-2">
			{ children... }
		</div>
	</div>
}
