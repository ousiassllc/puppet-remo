package pages

import (
	"github.com/ousiassllc/puppet-remo/internal/web/layout"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// 未登録デバイスの待機ページ（FR-W02）。ミドルウェアが 403 device_not_registered と一緒に返す。
// どれも data-error-code="device_not_registered" と、接続要求の状態 data-connection-state を持つ。

// Pending は接続要求を送信して、ホストの許可を待っているページ。
templ Pending() {
	@layout.RemoteNotice("接続要求を送信しました") {
		<main data-error-code="device_not_registered" data-connection-state="pending">
			<h1>接続要求を送信しました</h1>
			<p>接続要求を送信しました。ホストの許可を待っています。</p>
			<p>許可されたあと、このページを再読み込みするとビューアが開きます。</p>
		</main>
	}
}

// Denied はホストが接続要求を拒否したページ。
templ Denied() {
	@layout.RemoteNotice("接続要求は拒否されました") {
		<main data-error-code="device_not_registered" data-connection-state="denied">
			<h1>接続要求は拒否されました</h1>
			<p>ホストがこのデバイスの接続要求を拒否しました。心当たりがある場合は、ホストの所有者に連絡してください。</p>
			<p>拒否から 24 時間は、このデバイスから新しい接続要求は送信されません。</p>
		</main>
	}
}

// Expired は接続要求の有効期限（24 時間）が切れたページ。
templ Expired() {
	@layout.RemoteNotice("接続要求の有効期限が切れました") {
		<main data-error-code="device_not_registered" data-connection-state="expired">
			<h1>接続要求の有効期限が切れました</h1>
			<p>ホストの許可がないまま、接続要求の有効期限（24 時間）が切れました。</p>
			<p>しばらくしてからこのページを再読み込みすると、改めて接続要求を送信します。</p>
		</main>
	}
}

// RemoteError はリモートの Web UI のエラーページ（ミドルウェアの拒否・ページルートの失敗）。
templ RemoteError(v view.RemoteError) {
	@layout.RemoteNotice(v.Title) {
		<main data-error-code={ v.Code }>
			<h1>{ v.Title }</h1>
			<p>{ v.Message }</p>
		</main>
	}
}
