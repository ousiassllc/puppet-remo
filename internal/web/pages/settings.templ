package pages

import (
	"github.com/ousiassllc/puppet-remo/internal/web/layout"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/organisms"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

const settingsTitle = "設定"

templ settingsBody(v view.Settings) {
	<div class="max-w-xl space-y-6">
		<h1 class="text-3xl font-semibold text-ink">設定</h1>
		<p class="text-base text-ink" data-notice="agent-link">
			内蔵エージェント（既定は無効）と API キーの設定は、<a href="/agent" class="link" hx-boost="true" hx-target="#main" hx-target-error="#main" hx-swap="innerHTML">エージェント</a>の画面にあります。
		</p>
		@molecules.Card("") {
			@organisms.SettingsForm(v.Form)
		}
		<p class="text-base text-ink" data-notice="licenses-link">
			同梱するフォント・アイコン・ライブラリの<a href="/licenses" class="link" hx-boost="true" hx-target="#main" hx-target-error="#main" hx-swap="innerHTML">ライセンス表記</a>を読めます。
		</p>
	</div>
}

// Settings は設定のフルページ（FR-S01〜S04、FR-S06〜S09）。
templ Settings(v view.Settings) {
	@layout.GUI(settingsTitle, v.Chrome) {
		@settingsBody(v)
	}
}

// SettingsBoosted は hx-boost の遷移への応答。
templ SettingsBoosted(v view.Settings) {
	@layout.Boosted(settingsTitle, v.Chrome) {
		@settingsBody(v)
	}
}
