package pages

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/layout"
	"github.com/ousiassllc/puppet-remo/internal/web/organisms"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

const dashboardTitle = "ダッシュボード"

templ dashboardBody(v view.Dashboard) {
	<div class="space-y-6">
		<h1 class="text-3xl font-semibold text-ink">ダッシュボード</h1>
		@organisms.RunningTasksPanel(v.Tasks)
		<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
			@organisms.ServerStatusPanel(v.Status)
			@organisms.KillSwitchPanel(v.KillSwitch)
			@organisms.LeasePanel(v.Lease)
			@organisms.SessionList(v.Sessions)
		</div>
		<div class="flex flex-wrap gap-2 text-sm">
			<a href="/requests" class="inline-flex items-center gap-2 link" hx-boost="true" hx-target="#main" hx-target-error="#main" hx-swap="innerHTML">
				接続要求を確認する
				@atoms.Icon(atoms.IconArrowRight, atoms.IconSM)
			</a>
			<a href="/clients" class="inline-flex items-center gap-2 link" hx-boost="true" hx-target="#main" hx-target-error="#main" hx-swap="innerHTML">
				クライアントを管理する
				@atoms.Icon(atoms.IconArrowRight, atoms.IconSM)
			</a>
		</div>
	</div>
}

// Dashboard はダッシュボードのフルページ（FR-H02）。
templ Dashboard(v view.Dashboard) {
	@layout.GUI(dashboardTitle, v.Chrome) {
		@dashboardBody(v)
	}
}

// DashboardBoosted は hx-boost の遷移への応答。
templ DashboardBoosted(v view.Dashboard) {
	@layout.Boosted(dashboardTitle, v.Chrome) {
		@dashboardBody(v)
	}
}
