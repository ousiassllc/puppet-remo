package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func requestsTabClass(active bool) string {
	base := "inline-flex items-center border-b-2 px-3 py-2 text-sm font-medium "
	if active {
		return base + "border-indigo-600 text-indigo-700"
	}
	return base + "border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-900"
}

func requestsTabAttrs(active bool) atoms.Attrs {
	if active {
		return atoms.Attrs{"aria-current": "page"}
	}
	return nil
}

func badgeTone(t view.BadgeTone) atoms.BadgeTone { return atoms.BadgeTone(t) }

// RequestsTabs は接続要求画面の「未処理」「履歴」のタブ。ページ遷移は hx-boost で #main だけを差し替える（サイドバーと同じ。§5.4）。
templ RequestsTabs(active view.RequestsTab) {
	<nav class="flex gap-2 border-b border-slate-200" aria-label="接続要求" data-requests-tabs>
		<a
			href="/requests"
			class={ requestsTabClass(active == view.RequestsTabPending) }
			hx-boost="true"
			hx-target="#main"
			hx-target-error="#main"
			hx-swap="innerHTML"
			{ requestsTabAttrs(active == view.RequestsTabPending)... }
		>未処理</a>
		<a
			href="/requests/history"
			class={ requestsTabClass(active == view.RequestsTabHistory) }
			hx-boost="true"
			hx-target="#main"
			hx-target-error="#main"
			hx-swap="innerHTML"
			{ requestsTabAttrs(active == view.RequestsTabHistory)... }
		>履歴</a>
	</nav>
}

// RequestHistoryPager は履歴のページ送り（前へ・次へ）。リンクは #request-history だけを差し替える（HX-Request のフラグメント）。
templ requestHistoryPager(v view.RequestHistory) {
	<nav class="flex items-center justify-between text-sm" aria-label="ページ送り" data-pager>
		if v.PrevURL != "" {
			<a
				href={ templ.SafeURL(v.PrevURL) }
				class="rounded-md border border-slate-300 bg-white px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50"
				hx-get={ v.PrevURL }
				hx-target="#request-history"
				hx-swap="outerHTML"
				hx-push-url="true"
				data-pager-prev
			>前へ（新しい要求）</a>
		} else {
			<span></span>
		}
		<span class="text-slate-500" data-page={ strconv.Itoa(v.Page) }>{ strconv.Itoa(v.Page) } ページ目</span>
		if v.NextURL != "" {
			<a
				href={ templ.SafeURL(v.NextURL) }
				class="rounded-md border border-slate-300 bg-white px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50"
				hx-get={ v.NextURL }
				hx-target="#request-history"
				hx-swap="outerHTML"
				hx-push-url="true"
				data-pager-next
			>次へ（古い要求）</a>
		} else {
			<span></span>
		}
	</nav>
}

// ConnectionRequestHistory は接続要求の履歴（届いた日時の新しい順。FR-H03）。許可・拒否・失効・未処理のすべてを出す。
// 読み取り専用で、操作は持たない（未処理の許可・拒否は「未処理」タブ）。ポーリングの対象ではない。
templ ConnectionRequestHistory(v view.RequestHistory) {
	<div id="request-history" class="space-y-3">
		if len(v.Rows) == 0 {
			<p class="rounded-lg border border-dashed border-slate-300 bg-white px-4 py-8 text-center text-sm text-slate-500" data-empty="request-history">
				表示できる接続要求の履歴はありません。
			</p>
		} else {
			<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
				<table class="min-w-full divide-y divide-slate-200 text-sm">
					<thead class="bg-slate-50 text-left text-xs font-semibold text-slate-600">
						<tr>
							<th scope="col" class="px-3 py-2">届いた日時</th>
							<th scope="col" class="px-3 py-2">デバイス名</th>
							<th scope="col" class="px-3 py-2">tailnet IP</th>
							<th scope="col" class="px-3 py-2">ユーザー</th>
							<th scope="col" class="px-3 py-2">結果</th>
							<th scope="col" class="px-3 py-2">処理した日時</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, r := range v.Rows {
							<tr data-history-request={ r.ID } data-result={ r.ResultCode }>
								<td class="whitespace-nowrap px-3 py-2 text-slate-700">{ r.ReceivedAt }</td>
								<td class="px-3 py-2 font-medium text-slate-800">{ r.DisplayName }</td>
								<td class="px-3 py-2"><code class="rounded bg-slate-100 px-1 py-0.5 text-xs">{ r.RemoteIP }</code></td>
								<td class="px-3 py-2 text-slate-700">{ r.LoginName }</td>
								<td class="px-3 py-2">
									@atoms.Badge(badgeTone(r.ResultTone), r.Result)
								</td>
								<td class="whitespace-nowrap px-3 py-2 text-slate-700">{ r.DecidedAt }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if v.PrevURL != "" || v.NextURL != "" {
			@requestHistoryPager(v)
		}
	</div>
}
