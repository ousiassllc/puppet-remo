package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func requestsTabClass(active bool) string {
	base := "motion-hover -mb-px inline-flex items-center border-b-2 px-3 py-2 text-sm "
	if active {
		return base + "border-accent text-ink"
	}
	return base + "border-transparent text-mute hover:border-mute hover:text-ink"
}

func requestsTabAttrs(active bool) atoms.Attrs {
	if active {
		return atoms.Attrs{"aria-current": "page"}
	}
	return nil
}

func badgeTone(t view.BadgeTone) atoms.BadgeTone { return atoms.BadgeTone(t) }

// RequestsTabs は接続要求画面の「未処理」「履歴」のタブ。ページ遷移は hx-boost で #main だけを差し替える（サイドバーと同じ。§5.4）。
templ RequestsTabs(active view.RequestsTab) {
	<nav class="flex gap-2 border-b border-border" aria-label="接続要求" data-requests-tabs>
		<a
			href="/requests"
			class={ requestsTabClass(active == view.RequestsTabPending) }
			hx-boost="true"
			hx-target="#main"
			hx-target-error="#main"
			hx-swap="innerHTML"
			{ requestsTabAttrs(active == view.RequestsTabPending)... }
		>未処理</a>
		<a
			href="/requests/history"
			class={ requestsTabClass(active == view.RequestsTabHistory) }
			hx-boost="true"
			hx-target="#main"
			hx-target-error="#main"
			hx-swap="innerHTML"
			{ requestsTabAttrs(active == view.RequestsTabHistory)... }
		>履歴</a>
	</nav>
}

// RequestHistoryPager は履歴のページ送り（前へ・次へ）。リンクは #request-history だけを差し替える（HX-Request のフラグメント）。
templ requestHistoryPager(v view.RequestHistory) {
	<nav class="flex items-center justify-between text-sm" aria-label="ページ送り" data-pager>
		if v.PrevURL != "" {
			<a
				href={ templ.SafeURL(v.PrevURL) }
				class={ atoms.PagerButtonClass() }
				data-ripple
				hx-get={ v.PrevURL }
				hx-target="#request-history"
				hx-swap="outerHTML"
				hx-push-url="true"
				data-pager-prev
			>前へ（新しい要求）</a>
		} else {
			<span></span>
		}
		<span class="text-mute" data-page={ strconv.Itoa(v.Page) }>{ strconv.Itoa(v.Page) } ページ目</span>
		if v.NextURL != "" {
			<a
				href={ templ.SafeURL(v.NextURL) }
				class={ atoms.PagerButtonClass() }
				data-ripple
				hx-get={ v.NextURL }
				hx-target="#request-history"
				hx-swap="outerHTML"
				hx-push-url="true"
				data-pager-next
			>次へ（古い要求）</a>
		} else {
			<span></span>
		}
	</nav>
}

// ConnectionRequestHistory は接続要求の履歴（届いた日時の新しい順。FR-H03）。許可・拒否・失効・未処理のすべてを出す。
// 読み取り専用で、操作は持たない（未処理の許可・拒否は「未処理」タブ）。ポーリングの対象ではない。
templ ConnectionRequestHistory(v view.RequestHistory) {
	<div id="request-history" class="space-y-3">
		if len(v.Rows) == 0 {
			@molecules.EmptyState("request-history") {
				表示できる接続要求の履歴はありません。
			}
		} else {
			<div class="overflow-x-auto rounded-lg border border-border bg-surface">
				<table class="min-w-full divide-y divide-border text-sm">
					<thead class="text-left text-xs font-semibold text-mute">
						<tr>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">届いた日時</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">デバイス名</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">tailnet IP</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">ユーザー</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">結果</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">処理した日時</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						for _, r := range v.Rows {
							<tr class="hover:bg-accent-soft" data-history-request={ r.ID } data-result={ r.ResultCode }>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) font-mono text-ink">{ r.ReceivedAt }</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.DisplayName }</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y)"><code class="rounded-sm bg-accent-soft px-2 py-1 text-xs">{ r.RemoteIP }</code></td>
								<td class="px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.LoginName }</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y)">
									@atoms.Badge(badgeTone(r.ResultTone), r.Result)
								</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) font-mono text-ink">{ r.DecidedAt }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if v.PrevURL != "" || v.NextURL != "" {
			@requestHistoryPager(v)
		}
	</div>
}
