package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// TaskStatus はタスクの状態の 1 行（状態バッジ・ステップ数・経過時間・中断のボタン。FR-H10・FR-H02）。ダッシュボードの実行中タスクと
// タスクの詳細が同じ部品を使い、POST /tasks/{id}/cancel の応答はこの部品で、呼び出し元の同じ部品を差し替える
// （hx-target は closest [data-task-status]）。中断のボタンは、中断できる状態（CancelURL がある）のときだけ描画する（状態駆動）。
templ TaskStatus(v view.TaskStatus) {
	<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm" data-task-status={ v.Code }>
		@atoms.Badge(badgeTone(v.Tone), v.Label)
		<span class="text-slate-600">ステップ <span class="font-medium tabular-nums text-slate-900" data-task-steps>{ v.Steps }</span></span>
		<span class="text-slate-600">経過 <span class="font-medium text-slate-900" data-task-elapsed>{ v.Elapsed }</span></span>
		if v.CancelURL != "" {
			@atoms.Button(atoms.ButtonProps{Label: "中断", Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
				"hx-post": v.CancelURL, "hx-target": "closest [data-task-status]", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
			}})
		}
	</div>
}

// runningTasks はダッシュボードの実行中タスクのパネル。いつも #running-tasks を描画し（GET /poll の OOB の差し込み先）、
// 隠し入力 rev_tasks（data-poll-rev）に描画した状態の版を持つ。実行中・承認待ちのタスクが無いときは、パネルの中身は描画しない。
templ runningTasks(v view.RunningTasks, oob bool) {
	<div id="running-tasks" { oobAttrs(oob)... }>
		<input type="hidden" name="rev_tasks" value={ v.Rev } data-poll-rev/>
		if len(v.Items) > 0 {
			@molecules.Card("実行中のエージェントタスク") {
				<ul class="divide-y divide-slate-100" data-running-tasks>
					for _, t := range v.Items {
						<li class="space-y-2 py-3 first:pt-0 last:pb-0" data-running-task>
							<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
								<a
									href={ templ.SafeURL(t.DetailURL) }
									class="font-mono text-xs font-medium text-indigo-700 hover:underline"
									hx-boost="true"
									hx-target="#main"
									hx-target-error="#main"
									hx-swap="innerHTML"
									data-task-id
								>{ t.ShortID }</a>
								<span class="text-slate-500">依頼元: <span class="font-medium text-slate-800" data-task-client>{ t.Client }</span></span>
							</div>
							<p class="break-words text-sm text-slate-800" data-task-prompt>{ t.PromptExcerpt }</p>
							@TaskStatus(t.Status)
						</li>
					}
				</ul>
			}
		}
	</div>
}

// RunningTasksPanel はダッシュボードの実行中タスク（FR-H02）。
templ RunningTasksPanel(v view.RunningTasks) {
	@runningTasks(v, false)
}

// RunningTasksOOB は GET /poll の応答に添えて、実行中タスクのパネルを差し替える（OOB）。
templ RunningTasksOOB(v view.RunningTasks) {
	@runningTasks(v, true)
}

// TaskList はタスクの一覧（新しい順の表・「次へ」。FR-H10）。読み取り専用で、ポーリングの対象ではない。
// 「次へ」は #task-list を差し替える（HX-Request のフラグメント）。指示の先頭は利用者・MCP クライアント由来なので templ が HTML エスケープする。
templ TaskList(v view.TaskList) {
	<div id="task-list" class="space-y-3">
		if len(v.Rows) == 0 {
			<p class="rounded-lg border border-dashed border-slate-300 bg-white px-4 py-8 text-center text-sm text-slate-500" data-empty="task-list">
				エージェントのタスクはまだありません。
			</p>
		} else {
			<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
				<table class="min-w-full divide-y divide-slate-200 text-sm">
					<thead class="bg-slate-50 text-left text-xs font-semibold text-slate-600">
						<tr>
							<th scope="col" class="px-3 py-2">開始</th>
							<th scope="col" class="px-3 py-2">タスク</th>
							<th scope="col" class="px-3 py-2">依頼元</th>
							<th scope="col" class="px-3 py-2">指示</th>
							<th scope="col" class="px-3 py-2">状態</th>
							<th scope="col" class="whitespace-nowrap px-3 py-2">ステップ</th>
							<th scope="col" class="whitespace-nowrap px-3 py-2">所要時間</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, r := range v.Rows {
							<tr data-task-row={ r.DetailURL } data-status={ r.Code }>
								<td class="whitespace-nowrap px-3 py-2 text-slate-700">{ r.Created }</td>
								<td class="whitespace-nowrap px-3 py-2">
									<a
										href={ templ.SafeURL(r.DetailURL) }
										class="font-mono text-xs font-medium text-indigo-700 hover:underline"
										hx-boost="true"
										hx-target="#main"
										hx-target-error="#main"
										hx-swap="innerHTML"
									>{ r.ShortID }</a>
								</td>
								<td class="px-3 py-2 font-medium text-slate-800">{ r.Client }</td>
								<td class="max-w-md break-words px-3 py-2 text-slate-700">{ r.PromptExcerpt }</td>
								<td class="whitespace-nowrap px-3 py-2">
									@atoms.Badge(badgeTone(r.Tone), r.Label)
								</td>
								<td class="whitespace-nowrap px-3 py-2 tabular-nums text-slate-700">{ r.Steps }</td>
								<td class="whitespace-nowrap px-3 py-2 text-slate-700">{ r.Elapsed }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if v.NextURL != "" {
			<nav class="flex items-center justify-end text-sm" aria-label="ページ送り" data-pager>
				<a
					href={ templ.SafeURL(v.NextURL) }
					class="rounded-md border border-slate-300 bg-white px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50"
					hx-get={ v.NextURL }
					hx-target="#task-list"
					hx-swap="outerHTML"
					hx-push-url="true"
					data-pager-next
				>次へ（古いタスク）</a>
			</nav>
		}
	</div>
}

// taskField はタスクの詳細の項目 1 つ。値が空の項目は描画しない（無い項目を「-」で埋めない）。
templ taskField(label, value, name string) {
	if value != "" {
		<div class="flex gap-2">
			<dt class="w-28 shrink-0 font-semibold text-slate-600">{ label }</dt>
			<dd class="break-all text-slate-800" data-task-field={ name }>{ value }</dd>
		</div>
	}
}

templ taskStepArgs(args []view.AuditArg) {
	if len(args) > 0 {
		<dl class="mt-1 space-y-0.5 text-xs text-slate-500" data-step-args>
			for _, a := range args {
				<div class="flex gap-1">
					<dt class="font-medium">{ a.Key }:</dt>
					<dd class="break-all">{ a.Value }</dd>
				</div>
			}
		</dl>
	}
}

// TaskDetail はタスク 1 件の詳細（FR-H10・FR-G23）。指示・最終回答・ステップの文字列はすべて templ が HTML エスケープする。
// ステップは監査ログの行で、入力した文字列の本文・要素の値は持たない。サムネイルは監査の画面と同じ経路（/audit/{id}/thumbnail）。
templ TaskDetail(v view.TaskDetail) {
	<div class="space-y-4" data-task-detail={ v.ID }>
		<div class="space-y-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
			@TaskStatus(v.Status)
			<dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
				@taskField("タスク ID", v.ID, "id")
				@taskField("依頼元", v.Client, "client")
				@taskField("モデル", v.Model, "model")
				@taskField("上限", "ステップ " + strconv.Itoa(v.MaxSteps) + " ・ " + strconv.Itoa(v.MaxDurationSec) + " 秒", "limits")
				@taskField("ステップ数", strconv.Itoa(v.StepCount) + "（高速パス " + strconv.Itoa(v.FastSteps) + " ・ OpenAI " + strconv.Itoa(v.OpenAISteps) + "）", "step-count")
				@taskField("引き継ぎ理由", v.Handoff, "handoff-reason")
				@taskField("入力トークン", v.InputTokens, "input-tokens")
				@taskField("出力トークン", v.OutputTokens, "output-tokens")
				@taskField("作成", v.Created, "created")
				@taskField("開始", v.Started, "started")
				@taskField("終了", v.Finished, "finished")
				@taskField("エラーコード", v.ErrorCode, "error-code")
				@taskField("エラーの内容", v.ErrorLabel, "error-label")
			</dl>
		</div>
		<section class="space-y-2" aria-label="指示">
			<h2 class="text-sm font-semibold text-slate-800">指示</h2>
			<pre class="max-h-64 overflow-auto whitespace-pre-wrap break-words rounded-lg border border-slate-200 bg-white p-3 text-sm text-slate-800 shadow-sm" data-task-prompt>{ v.Prompt }</pre>
		</section>
		<section class="space-y-2" aria-label="最終回答">
			<h2 class="text-sm font-semibold text-slate-800">最終回答</h2>
			if v.ResultText == "" {
				<p class="text-sm text-slate-500" data-empty="task-result">最終回答はありません。</p>
			} else {
				<pre class="max-h-64 overflow-auto whitespace-pre-wrap break-words rounded-lg border border-slate-200 bg-white p-3 text-sm text-slate-800 shadow-sm" data-task-result>{ v.ResultText }</pre>
				if v.ResultNote != "" {
					<p class="rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-800" data-task-result-note>{ v.ResultNote }</p>
				}
			}
		</section>
		<section class="space-y-2" aria-label="ステップ">
			<h2 class="text-sm font-semibold text-slate-800">ステップ</h2>
			if len(v.Steps) == 0 {
				<p class="text-sm text-slate-500" data-empty="task-steps">記録されたステップはありません。</p>
			} else {
				<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
					<table class="min-w-full divide-y divide-slate-200 text-sm" data-task-steps-table>
						<thead class="bg-slate-50 text-left text-xs font-semibold text-slate-600">
							<tr>
								<th scope="col" class="px-3 py-2">#</th>
								<th scope="col" class="px-3 py-2">経路</th>
								<th scope="col" class="px-3 py-2">アクション</th>
								<th scope="col" class="px-3 py-2">結果</th>
								<th scope="col" class="px-3 py-2">日時</th>
								<th scope="col" class="px-3 py-2">画像</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, s := range v.Steps {
								<tr data-step-no={ strconv.Itoa(s.No) } data-route={ s.Route }>
									<td class="whitespace-nowrap px-3 py-2 tabular-nums text-slate-700">{ strconv.Itoa(s.No) }</td>
									<td class="whitespace-nowrap px-3 py-2">
										@atoms.Badge(atoms.BadgeNeutral, s.RouteLabel)
									</td>
									<td class="px-3 py-2 text-slate-800">
										<span class="font-medium">{ s.Summary }</span>
										<span class="ml-1 text-xs text-slate-500">{ s.Event }</span>
										@taskStepArgs(s.Args)
										if s.AuditURL != "" {
											<a
												href={ templ.SafeURL(s.AuditURL) }
												class="mt-1 block text-xs font-medium text-indigo-700 hover:underline"
												hx-boost="true"
												hx-target="#main"
												hx-target-error="#main"
												hx-swap="innerHTML"
												data-step-audit
											>監査ログを見る</a>
										}
									</td>
									<td class="px-3 py-2">
										@atoms.Badge(badgeTone(s.ResultTone), s.Result)
									</td>
									<td class="whitespace-nowrap px-3 py-2 text-slate-700">{ s.At }</td>
									<td class="px-3 py-2">
										if s.ThumbURL != "" {
											<img
												src={ s.ThumbURL }
												alt={ "ステップ " + strconv.Itoa(s.No) + " の直後の縮小スクリーンショット" }
												loading="lazy"
												class="h-16 w-auto rounded border border-slate-200"
												data-step-thumb
											/>
										} else {
											<span class="text-slate-400">-</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<a
			href={ templ.SafeURL(v.BackURL) }
			class="text-sm font-medium text-indigo-700 hover:underline"
			hx-boost="true"
			hx-target="#main"
			hx-target-error="#main"
			hx-swap="innerHTML"
		>タスクの一覧へ戻る</a>
	</div>
}
