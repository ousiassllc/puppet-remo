package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// TaskStatus はタスクの状態の 1 行（状態バッジ・ステップ数・経過時間・中断のボタン。FR-H10・FR-H02）。ダッシュボードの実行中タスクと
// タスクの詳細が同じ部品を使い、POST /tasks/{id}/cancel の応答はこの部品で、呼び出し元の同じ部品を差し替える
// （確認モーダルの確定が、DOMID の要素を差し替える）。中断は元に戻せないので、ボタンは確認モーダルを開く（破壊的な操作は確認を経る。O2）。
// ボタンは、中断できる状態（ConfirmURL がある）のときだけ描画する（状態駆動）。
templ TaskStatus(v view.TaskStatus) {
	<div id={ v.DOMID } class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm" data-task-status={ v.Code }>
		@atoms.Badge(badgeTone(v.Tone), v.Label)
		<span class="text-ink">ステップ <span class="font-mono text-ink" data-task-steps>{ v.Steps }</span></span>
		<span class="text-ink">経過 <span class="font-mono text-ink" data-task-elapsed>{ v.Elapsed }</span></span>
		if v.ConfirmURL != "" {
			@atoms.Button(atoms.ButtonProps{Label: "中断", Small: true, Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
				"hx-get": v.ConfirmURL, "hx-target": "#modal-root", "hx-swap": "innerHTML",
			}})
		}
	</div>
}

// runningTasks はダッシュボードの実行中タスクのパネル。いつも #running-tasks を描画し（GET /poll の OOB の差し込み先）、
// 隠し入力 rev_tasks（data-poll-rev）に描画した状態の版を持つ。実行中・承認待ちのタスクが無いときは、パネルの中身は描画せず、枠も hidden にする
// （ダッシュボードの Card の積みの gap-6 = 24 に、空の枠の分が入らないように）。
templ runningTasks(v view.RunningTasks, oob bool) {
	<div id="running-tasks" hidden?={ len(v.Items) == 0 } { oobAttrs(oob)... }>
		<input type="hidden" name="rev_tasks" value={ v.Rev } data-poll-rev/>
		if len(v.Items) > 0 {
			@molecules.Card("実行中のエージェントタスク") {
				<ul class="divide-y divide-border" data-running-tasks>
					for _, t := range v.Items {
						<li class="space-y-2 py-3 first:pt-0 last:pb-0" data-running-task>
							<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
								<a
									href={ templ.SafeURL(t.DetailURL) }
									class="font-mono text-sm link"
									hx-boost="true"
									hx-target="#main"
									hx-target-error="#main"
									hx-swap="innerHTML"
									data-task-id
								>{ t.ShortID }</a>
								<span class="text-mute">依頼元: <span class="text-ink" data-task-client>{ t.Client }</span></span>
								if t.Target.Scoped() {
									<span class="text-mute">対象: <span class="text-ink" data-task-target>@taskTarget(t.Target, false)</span></span>
								}
							</div>
							<p class="break-words text-sm text-ink" data-task-prompt>{ t.PromptExcerpt }</p>
							@TaskStatus(t.Status)
						</li>
					}
				</ul>
			}
		}
	</div>
}

// RunningTasksPanel はダッシュボードの実行中タスク（FR-H02）。
templ RunningTasksPanel(v view.RunningTasks) {
	@runningTasks(v, false)
}

// RunningTasksOOB は GET /poll の応答に添えて、実行中タスクのパネルを差し替える（OOB）。
templ RunningTasksOOB(v view.RunningTasks) {
	@runningTasks(v, true)
}

// TaskList はタスクの一覧（新しい順の表・「次へ」。FR-H10）。読み取り専用で、ポーリングの対象ではない。
// 「次へ」は #task-list を差し替える（HX-Request のフラグメント）。指示の先頭は利用者・MCP クライアント由来なので templ が HTML エスケープする。
// sm（640px）以上は表。sm 未満は表が指示の列を 1 文字ずつ縦に折ってしまう（#178）ので、表を隠して 1 件 1 枚のカード（taskCard）の縦積みに替える
// （同じ行を 2 通りに描く。表の行は data-task-row、カードは data-task-card。どちらかは display:none で、読み上げにも出ない）。
templ TaskList(v view.TaskList) {
	<div id="task-list" class="space-y-4">
		if len(v.Rows) == 0 {
			@molecules.EmptyState("task-list") {
				エージェントのタスクはまだありません。
			}
		} else {
			<ul class="space-y-2 sm:hidden" data-task-cards>
				for _, r := range v.Rows {
					@taskCard(r)
				}
			</ul>
			<div class="hidden overflow-x-auto rounded-lg border border-border bg-surface sm:block">
				<table class="min-w-full divide-y divide-border text-sm">
					<thead class="text-left text-xs font-semibold text-mute">
						<tr>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">開始</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">タスク</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">依頼元</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">指示</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">状態</th>
							<th scope="col" class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right">ステップ</th>
							<th scope="col" class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right">所要時間</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						for _, r := range v.Rows {
							<tr class="hover:bg-accent-soft" data-task-row={ r.DetailURL } data-status={ r.Code }>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) font-mono text-ink">{ r.Created }</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y)">
									<a
										href={ templ.SafeURL(r.DetailURL) }
										class="font-mono text-sm link"
										hx-boost="true"
										hx-target="#main"
										hx-target-error="#main"
										hx-swap="innerHTML"
									>{ r.ShortID }</a>
								</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.Client }</td>
								<td class="max-w-md break-words px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.PromptExcerpt }</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y)">
									@atoms.Badge(badgeTone(r.Tone), r.Label)
								</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right font-mono text-ink">{ r.Steps }</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right font-mono text-ink">{ r.Elapsed }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if v.PrevURL != "" || v.NextURL != "" {
			@molecules.Pager(molecules.PagerProps{Page: v.Page, PrevURL: v.PrevURL, NextURL: v.NextURL, PrevLabel: "前へ（新しいタスク）", NextLabel: "次へ（古いタスク）", Target: "#task-list"})
		}
	</div>
}

// taskCard は sm 未満のタスク 1 件のカード（#178）。3 段: 1 段目 = 開始日時（Mono）と状態のピル、2 段目 = 指示（最大 2 行の line-clamp）、
// 3 段目 = ミュートの 1 行（タスク ID のリンク・依頼元・ステップ・所要時間。依頼元だけが縮んで「…」になり、他は折り返さない）。
// カード全体が 1 つのリンク: タスク ID のリンクの ::after がカードを覆い（after:absolute after:inset-0）、押すと詳細へ移る。キーボードはこのリンクに止まり、
// フォーカスリングはカードの外周に出る（app.css の .task-card）。余白は内側 --pad-card-sm（16）・段の間 8・カードの間 8（ul の space-y-2）。
// ホバーで --accent-soft 地になるので、ミュートの文字は group-hover で --mute-on-soft にする（C6）。
templ taskCard(r view.TaskRow) {
	<li class="task-card group relative cursor-pointer space-y-2 rounded-lg border border-border bg-surface p-(--pad-card-sm) hover:bg-accent-soft" data-task-card={ r.DetailURL } data-status={ r.Code }>
		<div class="flex items-center justify-between gap-2">
			<span class="whitespace-nowrap font-mono text-sm text-ink">{ r.Created }</span>
			<span class="shrink-0 whitespace-nowrap">
				@atoms.Badge(badgeTone(r.Tone), r.Label)
			</span>
		</div>
		<p class="line-clamp-2 break-words text-sm text-ink" data-task-card-prompt>{ r.PromptExcerpt }</p>
		<p class="flex items-baseline gap-x-2 whitespace-nowrap text-xs text-mute group-hover:text-mute-on-soft">
			<a
				href={ templ.SafeURL(r.DetailURL) }
				class="task-card-link link shrink-0 font-mono text-sm after:absolute after:inset-0"
				hx-boost="true"
				hx-target="#main"
				hx-target-error="#main"
				hx-swap="innerHTML"
			>{ r.ShortID }</a>
			<span aria-hidden="true">・</span>
			<span class="min-w-0 flex-1 truncate">{ r.Client }</span>
			<span aria-hidden="true">・</span>
			<span class="shrink-0">ステップ <span class="font-mono">{ r.Steps }</span></span>
			<span aria-hidden="true">・</span>
			<span class="shrink-0 font-mono">{ r.Elapsed }</span>
		</p>
	</li>
}

// taskField はタスクの詳細の項目 1 つ（値が文字列 1 つのとき）。値が空の項目は描画しない（無い項目を「-」で埋めない）。
// mono は値が日時・ID・数値のとき true（桁を揃える値は Mono。文章は Regular のまま）。
templ taskField(label, value, name string, mono bool) {
	if value != "" {
		@taskRow(label, name, mono) {
			{ value }
		}
	}
}

// taskRow は詳細の項目 1 つの枠。値は children で渡す。「ステップ N ・ M 秒」のように日本語の文言と数値が混ざる値は、
// mono = false のまま、数値だけを <span class="font-mono"> で包んで渡す（ガイド T5。文に埋めた値と同じ書き方）。
templ taskRow(label, name string, mono bool) {
	<div class="flex gap-2">
		<dt class="w-28 shrink-0 text-mute">{ label }</dt>
		<dd class={ "break-all text-ink", templ.KV("font-mono", mono) } data-task-field={ name }>{ children... }</dd>
	</div>
}

// taskTarget はタスクの対象の値。プロセス名・pid・window_id（機械的な識別子）だけを Mono にし、「（ ）」「pid」「・」は Regular（#220。ガイド T5）。
// ダッシュボードはプロセス名・pid、詳細は window_id も付ける（withWindowID）。
templ taskTarget(t view.TaskTarget, withWindowID bool) {
	if t.Process != "" {
		<span class="font-mono">{ t.Process }</span>（pid <span class="font-mono">{ strconv.Itoa(t.PID) }</span>）
	} else {
		pid <span class="font-mono">{ strconv.Itoa(t.PID) }</span>
	}
	if withWindowID {
		<span> ・ window_id <span class="font-mono">{ t.WindowID }</span></span>
	}
}

templ taskStepArgs(args []view.AuditArg) {
	if len(args) > 0 {
		<dl class="mt-1 space-y-2 text-sm text-ink" data-step-args>
			for _, a := range args {
				<div class="flex gap-1">
					<dt class="font-mono text-mute group-hover:text-mute-on-soft">{ a.Key }:</dt>
					<dd class="break-all font-mono">{ a.Value }</dd>
				</div>
			}
		</dl>
	}
}

// TaskDetail はタスク 1 件の詳細（FR-H10・FR-G23）。指示・最終回答・ステップの文字列はすべて templ が HTML エスケープする。
// ステップは監査ログの行で、入力した文字列の本文・要素の値は持たない。サムネイルは監査の画面と同じ経路（/audit/{id}/thumbnail）。題付きの Card（部品）同士は 24（--gap-grid-lg。space-y-6）。
templ TaskDetail(v view.TaskDetail) {
	<div class="space-y-6" data-task-detail={ v.ID }>
		<div class="space-y-4 rounded-lg border border-border bg-surface p-(--pad-card)">
			@TaskStatus(v.Status)
			<dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
				@taskField("タスク ID", v.ID, "id", true)
				@taskField("依頼元", v.Client, "client", false)
				@taskField("モデル", v.Model, "model", false)
				@taskRow("上限", "limits", false) {
					ステップ <span class="font-mono">{ strconv.Itoa(v.MaxSteps) }</span> ・ <span class="font-mono">{ strconv.Itoa(v.MaxDurationSec) }</span> 秒
				}
				@taskRow("ステップ数", "step-count", false) {
					<span class="font-mono">{ strconv.Itoa(v.StepCount) }</span>（高速パス <span class="font-mono">{ strconv.Itoa(v.FastSteps) }</span> ・ OpenAI <span class="font-mono">{ strconv.Itoa(v.OpenAISteps) }</span>）
				}
				if v.HandoffReason != "" {
					@taskRow("引き継ぎ理由", "handoff-reason", false) {
						if v.HandoffText != "" {
							{ v.HandoffText }（<span class="font-mono">{ v.HandoffReason }</span>）
						} else {
							<span class="font-mono">{ v.HandoffReason }</span>
						}
					}
				}
				if v.Target.Scoped() {
					@taskRow("対象ウィンドウ", "target", false) {
						@taskTarget(v.Target, true)
					}
				}
				@taskField("表示から除外", v.CapturePartial, "capture-partial", false)
				@taskField("入力トークン", v.InputTokens, "input-tokens", true)
				@taskField("出力トークン", v.OutputTokens, "output-tokens", true)
				@taskField("作成", v.Created, "created", true)
				@taskField("開始", v.Started, "started", true)
				@taskField("終了", v.Finished, "finished", true)
				@taskField("エラーコード", v.ErrorCode, "error-code", true)
				@taskField("エラーの内容", v.ErrorLabel, "error-label", false)
			</dl>
		</div>
		@molecules.Card("指示") {
			<pre class="max-h-64 overflow-auto whitespace-pre-wrap break-words rounded-md bg-bone p-4 font-sans text-sm text-ink" { atoms.ScrollRegion("指示の全文")... } data-task-prompt>{ v.Prompt }</pre>
		}
		@molecules.Card("最終回答") {
			if v.ResultText == "" {
				@molecules.EmptyState("task-result") {
					最終回答はありません。
				}
			} else {
				<pre class="max-h-64 overflow-auto whitespace-pre-wrap break-words rounded-md bg-bone p-4 font-sans text-sm text-ink" { atoms.ScrollRegion("最終回答の全文")... } data-task-result>{ v.ResultText }</pre>
				if v.ResultNote != "" {
					@atoms.Notice(atoms.AlertInfo, atoms.Attrs{"data-task-result-note": true}) {
						{ v.ResultNote }
					}
				}
			}
		}
		@molecules.Card("ステップ") {
			if len(v.Steps) == 0 {
				@molecules.EmptyState("task-steps") {
					記録されたステップはありません。
				}
			} else {
				<div class="overflow-x-auto" { atoms.ScrollRegion("ステップ")... }>
					<table class="min-w-full divide-y divide-border text-sm" data-task-steps-table>
						<thead class="text-left text-xs font-semibold text-mute">
							<tr>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y) text-right">#</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">経路</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">アクション</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">結果</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">日時</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">画像</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for i, s := range v.Steps {
								<tr class="group hover:bg-accent-soft" data-step-no={ strconv.Itoa(s.No) } data-route={ s.Route } data-step-kind={ stepKind(s) }>
									<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right font-mono text-ink">
										if s.KindLabel == "" {
											{ strconv.Itoa(s.No) }
										} else {
											@atoms.Tooltip("step-row-tip-"+strconv.Itoa(i), "ステップ "+strconv.Itoa(s.No)+" に付く行") {
												<span class="text-mute group-hover:text-mute-on-soft">-</span>
											}
										}
									</td>
									<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y)">
										@atoms.Badge(atoms.BadgeLabel, s.RouteLabel)
									</td>
									<td class="px-(--table-pad-x) py-(--table-pad-y) text-ink">
										if s.KindLabel != "" {
											<span class="mr-1 text-xs text-ink" data-step-kind-label>{ s.KindLabel }</span>
										}
										<span>{ s.Summary }</span>
										<span class="ml-1 font-mono text-xs text-mute group-hover:text-mute-on-soft">{ s.Event }</span>
										@taskStepArgs(s.Args)
										if s.AuditURL != "" {
											<a
												href={ templ.SafeURL(s.AuditURL) }
												class="mt-1 block text-sm link"
												hx-boost="true"
												hx-target="#main"
												hx-target-error="#main"
												hx-swap="innerHTML"
												data-step-audit
											>監査ログを見る</a>
										}
									</td>
									<td class="px-(--table-pad-x) py-(--table-pad-y)">
										@atoms.Badge(badgeTone(s.ResultTone), s.Result)
									</td>
									<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) font-mono text-ink">{ s.At }</td>
									<td class="px-(--table-pad-x) py-(--table-pad-y)">
										if s.ThumbURL != "" {
											<img
												src={ s.ThumbURL }
												alt={ "ステップ " + strconv.Itoa(s.No) + " の直後の縮小スクリーンショット" }
												loading="lazy"
												class="h-16 w-auto rounded-sm border border-border"
												data-step-thumb
											/>
										} else {
											<span class="text-mute group-hover:text-mute-on-soft">-</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
		<a
			href={ templ.SafeURL(v.BackURL) }
			class="text-sm link"
			hx-boost="true"
			hx-target="#main"
			hx-target-error="#main"
			hx-swap="innerHTML"
		>タスクの一覧へ戻る</a>
	</div>
}
