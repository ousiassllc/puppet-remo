package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// TaskStatus はタスクの状態の 1 行（状態バッジ・ステップ数・経過時間・中断のボタン。FR-H10・FR-H02）。ダッシュボードの実行中タスクと
// タスクの詳細が同じ部品を使い、POST /tasks/{id}/cancel の応答はこの部品で、呼び出し元の同じ部品を差し替える
// （確認モーダルの確定が、DOMID の要素を差し替える）。中断は元に戻せないので、ボタンは確認モーダルを開く（破壊的な操作は確認を経る。O2）。
// ボタンは、中断できる状態（ConfirmURL がある）のときだけ描画する（状態駆動）。
templ TaskStatus(v view.TaskStatus) {
	<div id={ v.DOMID } class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm" data-task-status={ v.Code }>
		@atoms.Badge(badgeTone(v.Tone), v.Label)
		<span class="text-ink">ステップ <span class="font-mono text-ink" data-task-steps>{ v.Steps }</span></span>
		<span class="text-ink">経過 <span class="font-mono text-ink" data-task-elapsed>{ v.Elapsed }</span></span>
		if v.ConfirmURL != "" {
			@atoms.Button(atoms.ButtonProps{Label: "中断", Small: true, Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
				"hx-get": v.ConfirmURL, "hx-target": "#modal-root", "hx-swap": "innerHTML",
			}})
		}
	</div>
}

// runningTasks はダッシュボードの実行中タスクのパネル。いつも #running-tasks を描画し（GET /poll の OOB の差し込み先）、
// 隠し入力 rev_tasks（data-poll-rev）に描画した状態の版を持つ。実行中・承認待ちのタスクが無いときは、パネルの中身は描画しない。
templ runningTasks(v view.RunningTasks, oob bool) {
	<div id="running-tasks" { oobAttrs(oob)... }>
		<input type="hidden" name="rev_tasks" value={ v.Rev } data-poll-rev/>
		if len(v.Items) > 0 {
			@molecules.Card("実行中のエージェントタスク") {
				<ul class="divide-y divide-border" data-running-tasks>
					for _, t := range v.Items {
						<li class="space-y-2 py-3 first:pt-0 last:pb-0" data-running-task>
							<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
								<a
									href={ templ.SafeURL(t.DetailURL) }
									class="font-mono text-xs link"
									hx-boost="true"
									hx-target="#main"
									hx-target-error="#main"
									hx-swap="innerHTML"
									data-task-id
								>{ t.ShortID }</a>
								<span class="text-mute">依頼元: <span class="text-ink" data-task-client>{ t.Client }</span></span>
							</div>
							<p class="break-words text-sm text-ink" data-task-prompt>{ t.PromptExcerpt }</p>
							@TaskStatus(t.Status)
						</li>
					}
				</ul>
			}
		}
	</div>
}

// RunningTasksPanel はダッシュボードの実行中タスク（FR-H02）。
templ RunningTasksPanel(v view.RunningTasks) {
	@runningTasks(v, false)
}

// RunningTasksOOB は GET /poll の応答に添えて、実行中タスクのパネルを差し替える（OOB）。
templ RunningTasksOOB(v view.RunningTasks) {
	@runningTasks(v, true)
}

// TaskList はタスクの一覧（新しい順の表・「次へ」。FR-H10）。読み取り専用で、ポーリングの対象ではない。
// 「次へ」は #task-list を差し替える（HX-Request のフラグメント）。指示の先頭は利用者・MCP クライアント由来なので templ が HTML エスケープする。
templ TaskList(v view.TaskList) {
	<div id="task-list" class="space-y-3">
		if len(v.Rows) == 0 {
			@molecules.EmptyState("task-list") {
				エージェントのタスクはまだありません。
			}
		} else {
			<div class="overflow-x-auto rounded-lg border border-border bg-surface">
				<table class="min-w-full divide-y divide-border text-sm">
					<thead class="text-left text-xs font-semibold text-mute">
						<tr>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">開始</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">タスク</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">依頼元</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">指示</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">状態</th>
							<th scope="col" class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right">ステップ</th>
							<th scope="col" class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right">所要時間</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						for _, r := range v.Rows {
							<tr class="hover:bg-accent-soft" data-task-row={ r.DetailURL } data-status={ r.Code }>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) font-mono text-ink">{ r.Created }</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y)">
									<a
										href={ templ.SafeURL(r.DetailURL) }
										class="font-mono text-xs link"
										hx-boost="true"
										hx-target="#main"
										hx-target-error="#main"
										hx-swap="innerHTML"
									>{ r.ShortID }</a>
								</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.Client }</td>
								<td class="max-w-md break-words px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.PromptExcerpt }</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y)">
									@atoms.Badge(badgeTone(r.Tone), r.Label)
								</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right font-mono text-ink">{ r.Steps }</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right font-mono text-ink">{ r.Elapsed }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if v.NextURL != "" {
			<nav class="flex items-center justify-end text-sm" aria-label="ページ送り" data-pager>
				<a
					href={ templ.SafeURL(v.NextURL) }
					class={ atoms.PagerButtonClass() }
					data-ripple
					hx-get={ v.NextURL }
					hx-target="#task-list"
					hx-swap="outerHTML"
					hx-push-url="true"
					data-pager-next
				>次へ（古いタスク）</a>
			</nav>
		}
	</div>
}

// taskField はタスクの詳細の項目 1 つ。値が空の項目は描画しない（無い項目を「-」で埋めない）。
templ taskField(label, value, name string) {
	if value != "" {
		<div class="flex gap-2">
			<dt class="w-28 shrink-0 text-mute">{ label }</dt>
			<dd class="break-all text-ink" data-task-field={ name }>{ value }</dd>
		</div>
	}
}

templ taskStepArgs(args []view.AuditArg) {
	if len(args) > 0 {
		<dl class="mt-1 space-y-1 text-sm text-ink" data-step-args>
			for _, a := range args {
				<div class="flex gap-1">
					<dt class="text-mute">{ a.Key }:</dt>
					<dd class="break-all">{ a.Value }</dd>
				</div>
			}
		</dl>
	}
}

// TaskDetail はタスク 1 件の詳細（FR-H10・FR-G23）。指示・最終回答・ステップの文字列はすべて templ が HTML エスケープする。
// ステップは監査ログの行で、入力した文字列の本文・要素の値は持たない。サムネイルは監査の画面と同じ経路（/audit/{id}/thumbnail）。
templ TaskDetail(v view.TaskDetail) {
	<div class="space-y-12" data-task-detail={ v.ID }>
		<div class="space-y-3 rounded-lg border border-border bg-surface p-4">
			@TaskStatus(v.Status)
			<dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
				@taskField("タスク ID", v.ID, "id")
				@taskField("依頼元", v.Client, "client")
				@taskField("モデル", v.Model, "model")
				@taskField("上限", "ステップ "+strconv.Itoa(v.MaxSteps)+" ・ "+strconv.Itoa(v.MaxDurationSec)+" 秒", "limits")
				@taskField("ステップ数", strconv.Itoa(v.StepCount)+"（高速パス "+strconv.Itoa(v.FastSteps)+" ・ OpenAI "+strconv.Itoa(v.OpenAISteps)+"）", "step-count")
				@taskField("引き継ぎ理由", v.Handoff, "handoff-reason")
				@taskField("入力トークン", v.InputTokens, "input-tokens")
				@taskField("出力トークン", v.OutputTokens, "output-tokens")
				@taskField("作成", v.Created, "created")
				@taskField("開始", v.Started, "started")
				@taskField("終了", v.Finished, "finished")
				@taskField("エラーコード", v.ErrorCode, "error-code")
				@taskField("エラーの内容", v.ErrorLabel, "error-label")
			</dl>
		</div>
		<section class="space-y-6" aria-label="指示">
			<h2 class="text-2xl font-semibold text-ink">指示</h2>
			<pre class="max-h-64 overflow-auto whitespace-pre-wrap break-words rounded-lg border border-border bg-surface p-4 font-sans text-sm text-ink" data-task-prompt>{ v.Prompt }</pre>
		</section>
		<section class="space-y-6" aria-label="最終回答">
			<h2 class="text-2xl font-semibold text-ink">最終回答</h2>
			if v.ResultText == "" {
				@molecules.EmptyState("task-result") {
					最終回答はありません。
				}
			} else {
				<pre class="max-h-64 overflow-auto whitespace-pre-wrap break-words rounded-lg border border-border bg-surface p-4 font-sans text-sm text-ink" data-task-result>{ v.ResultText }</pre>
				if v.ResultNote != "" {
					@atoms.Notice(atoms.AlertWarning, atoms.Attrs{"data-task-result-note": true}) {
						{ v.ResultNote }
					}
				}
			}
		</section>
		<section class="space-y-6" aria-label="ステップ">
			<h2 class="text-2xl font-semibold text-ink">ステップ</h2>
			if len(v.Steps) == 0 {
				@molecules.EmptyState("task-steps") {
					記録されたステップはありません。
				}
			} else {
				<div class="overflow-x-auto rounded-lg border border-border bg-surface">
					<table class="min-w-full divide-y divide-border text-sm" data-task-steps-table>
						<thead class="text-left text-xs font-semibold text-mute">
							<tr>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y) text-right">#</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">経路</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">アクション</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">結果</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">日時</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">画像</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, s := range v.Steps {
								<tr class="hover:bg-accent-soft" data-step-no={ strconv.Itoa(s.No) } data-route={ s.Route } data-step-kind={ stepKind(s) }>
									<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right font-mono text-ink">
										if s.KindLabel == "" {
											{ strconv.Itoa(s.No) }
										} else {
											<span class="text-mute" title={ "ステップ " + strconv.Itoa(s.No) + " に付く行" }>-</span>
										}
									</td>
									<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y)">
										@atoms.Badge(atoms.BadgeNeutral, s.RouteLabel)
									</td>
									<td class="px-(--table-pad-x) py-(--table-pad-y) text-ink">
										if s.KindLabel != "" {
											<span class="mr-1 text-xs text-ink" data-step-kind-label>{ s.KindLabel }</span>
										}
										<span>{ s.Summary }</span>
										<span class="ml-1 text-xs text-mute">{ s.Event }</span>
										@taskStepArgs(s.Args)
										if s.AuditURL != "" {
											<a
												href={ templ.SafeURL(s.AuditURL) }
												class="mt-1 block text-sm link"
												hx-boost="true"
												hx-target="#main"
												hx-target-error="#main"
												hx-swap="innerHTML"
												data-step-audit
											>監査ログを見る</a>
										}
									</td>
									<td class="px-(--table-pad-x) py-(--table-pad-y)">
										@atoms.Badge(badgeTone(s.ResultTone), s.Result)
									</td>
									<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) font-mono text-ink">{ s.At }</td>
									<td class="px-(--table-pad-x) py-(--table-pad-y)">
										if s.ThumbURL != "" {
											<img
												src={ s.ThumbURL }
												alt={ "ステップ " + strconv.Itoa(s.No) + " の直後の縮小スクリーンショット" }
												loading="lazy"
												class="h-16 w-auto rounded-sm border border-border"
												data-step-thumb
											/>
										} else {
											<span class="text-mute">-</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<a
			href={ templ.SafeURL(v.BackURL) }
			class="text-sm link"
			hx-boost="true"
			hx-target="#main"
			hx-target-error="#main"
			hx-swap="innerHTML"
		>タスクの一覧へ戻る</a>
	</div>
}
