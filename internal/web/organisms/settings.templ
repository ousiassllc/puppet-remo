package organisms

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func numberAttrs(min, max string) atoms.Attrs {
	return atoms.Attrs{"min": min, "max": max, "step": "1", "inputmode": "numeric"}
}

// updateApplyModeOptions は更新の適用方法（FR-S09）の選択肢。current が未知の値なら、どれも選ばない（検証エラーの再描画）。
func updateApplyModeOptions(current string) []atoms.SelectOption {
	return []atoms.SelectOption{
		{Value: "confirm", Label: "ホストが確認してから適用する（既定）", Selected: current == "confirm"},
		{Value: "auto_idle", Label: "アイドル時に自動で適用する", Selected: current == "auto_idle"},
	}
}

// updateChannelOptions は更新のチャネル（FR-S09）の選択肢。current が未知の値なら、どれも選ばない（検証エラーの再描画）。
func updateChannelOptions(current string) []atoms.SelectOption {
	return []atoms.SelectOption{
		{Value: "stable", Label: "正式版（既定）", Selected: current == "stable"},
		{Value: "nightly", Label: "ナイトリー（開発中の版。不安定なことがあります）", Selected: current == "nightly"},
	}
}

// SettingsForm は設定画面のフォーム（FR-S01〜S04、FR-S06〜S09）。検証エラーは 422 で、入力値とメッセージ付きで再描画する。
// 自動起動のチェックは、OS の登録手段があるときだけ描画する。
// 「監査ログ」のグループには、サムネイルと本文が平文で保存される旨（NFR-S11）を常に出す（確認ダイアログは作らない）。
// ブラウザの入力検証は novalidate で止める（検証はサーバーが行い、422 でメッセージ付きに再描画する。frontend.md §5.6）。
templ SettingsForm(f view.SettingsForm) {
	<form
		id="settings-form"
		class="space-y-5"
		novalidate
		hx-put="/settings"
		hx-target="this"
		hx-swap="outerHTML"
		hx-target-422="this"
		hx-disabled-elt="find button[type=submit]"
		hx-indicator="#settings-spinner"
	>
		@molecules.FormField("set-port", "待ち受けポート", "1024〜65535。保存すると新しいポートで待ち受け直します。", f.Errors.Port) {
			@atoms.Input(atoms.InputProps{ID: "set-port", Name: "server.port", Type: "number", Value: f.Values.Port, Required: true, Invalid: f.Errors.Port != "", Attrs: numberAttrs("1024", "65535")})
		}
		@molecules.FormField("set-hotkey", "キルスイッチのホットキー", "Ctrl+Alt+Shift+K の書式。", f.Errors.Hotkey) {
			@atoms.Input(atoms.InputProps{ID: "set-hotkey", Name: "killswitch.hotkey", Value: f.Values.Hotkey, Required: true, Invalid: f.Errors.Hotkey != "", Attrs: atoms.Attrs{"autocomplete": "off"}})
		}
		@molecules.FormField("set-maxdim", "スクリーンショットの最大辺（px）", "256〜4096。AI へ渡す画像の長辺の上限です。", f.Errors.ScreenshotMaxDim) {
			@atoms.Input(atoms.InputProps{ID: "set-maxdim", Name: "screenshot.max_dimension", Type: "number", Value: f.Values.ScreenshotMaxDim, Required: true, Invalid: f.Errors.ScreenshotMaxDim != "", Attrs: numberAttrs("256", "4096")})
		}
		@molecules.FormField("set-idle", "リースのアイドルタイムアウト（秒）", "30〜3600。操作がないまま経過すると操作権を解放します。", f.Errors.LeaseIdleSec) {
			@atoms.Input(atoms.InputProps{ID: "set-idle", Name: "lease.idle_timeout_sec", Type: "number", Value: f.Values.LeaseIdleSec, Required: true, Invalid: f.Errors.LeaseIdleSec != "", Attrs: numberAttrs("30", "3600")})
		}
		@molecules.FormField("set-vquality", "ビューアの既定の画質", "1〜100。Web ビューアを開いたときの JPEG の品質です。", f.Errors.ViewerQuality) {
			@atoms.Input(atoms.InputProps{ID: "set-vquality", Name: "viewer.default_quality", Type: "number", Value: f.Values.ViewerQuality, Required: true, Invalid: f.Errors.ViewerQuality != "", Attrs: numberAttrs("1", "100")})
		}
		@molecules.FormField("set-vfps", "ビューアの既定の FPS", "1〜30。Web ビューアを開いたときの 1 秒あたりの更新の上限です。", f.Errors.ViewerFPS) {
			@atoms.Input(atoms.InputProps{ID: "set-vfps", Name: "viewer.default_fps", Type: "number", Value: f.Values.ViewerFPS, Required: true, Invalid: f.Errors.ViewerFPS != "", Attrs: numberAttrs("1", "30")})
		}
		if f.CanSetAutostart {
			<label class="flex items-center gap-2 text-sm text-ink">
				@atoms.Checkbox("set-autostart", "autostart", f.Values.Autostart)
				ログオン時に自動で起動する
			</label>
		}
		<fieldset class="space-y-4 border-t border-border pt-4" data-settings-group="audit">
			<legend class="pr-2 text-sm font-semibold text-ink">監査ログ</legend>
			<p class="rounded-md border border-warning/40 bg-warning/10 px-3 py-2 text-xs text-warning" role="note" data-notice="audit-plaintext">
				サムネイル（スクリーンショットの縮小画像）と、有効にした場合の入力・クリップボードの本文は、暗号化されず<strong>平文</strong>でこのPCのディスクに保存されます。ディスクの紛失・盗難に備えて BitLocker でドライブ全体を暗号化してください。画面の内容を残したくないときは、サムネイルの保存を無効にできます。
			</p>
			<label class="flex items-center gap-2 text-sm text-ink">
				@atoms.Checkbox("set-audit-thumbs", "audit.thumbnails_enabled", f.Values.AuditThumbnails)
				サムネイルを保存する
			</label>
			<div class="space-y-1">
				<label class="flex items-center gap-2 text-sm text-ink">
					@atoms.Checkbox("set-audit-text", "audit.record_text", f.Values.AuditRecordText)
					入力（type）とクリップボードの本文を記録する
				</label>
				<p class="text-xs text-danger" data-notice="audit-record-text">有効にすると、パスワードなどの入力した内容も平文で保存されることがあります。通常は無効のままにしてください。</p>
			</div>
			@molecules.FormField("set-audit-days", "監査ログの保持期間（日）", "1〜36500。期間を過ぎたログとそのサムネイルは自動で削除されます。", f.Errors.AuditRetentionDays) {
				@atoms.Input(atoms.InputProps{ID: "set-audit-days", Name: "audit.retention_days", Type: "number", Value: f.Values.AuditRetentionDays, Required: true, Invalid: f.Errors.AuditRetentionDays != "", Attrs: numberAttrs("1", "36500")})
			}
			@molecules.FormField("set-audit-cap", "サムネイルの容量の上限（バイト）", "1〜9007199254740992。超えると古いサムネイルから削除します（ログの行は残ります）。既定は 1073741824（1 GiB）。", f.Errors.AuditThumbsMaxBytes) {
				@atoms.Input(atoms.InputProps{ID: "set-audit-cap", Name: "audit.thumbs_max_bytes", Type: "number", Value: f.Values.AuditThumbsMaxBytes, Required: true, Invalid: f.Errors.AuditThumbsMaxBytes != "", Attrs: numberAttrs("1", "9007199254740992")})
			}
		</fieldset>
		<fieldset class="space-y-4 border-t border-border pt-4" data-settings-group="update">
			<legend class="pr-2 text-sm font-semibold text-ink">更新</legend>
			@molecules.FormField("set-update-channel", "更新のチャネル", "追いかける版です。署名を検証できた更新だけを適用します。ナイトリーから正式版へは、新しい正式版が出たときに切り替わります。", f.Errors.UpdateChannel) {
				@atoms.Select("set-update-channel", "update.channel", updateChannelOptions(f.Values.UpdateChannel))
			}
			@molecules.FormField("set-update-mode", "更新の適用方法", "新しい版は 6 時間ごとに確認します。自動で適用するのは、操作権の保持・接続・実行中のタスクがないときだけです。", f.Errors.UpdateApplyMode) {
				@atoms.Select("set-update-mode", "update.apply_mode", updateApplyModeOptions(f.Values.UpdateApplyMode))
			}
		</fieldset>
		<div class="flex items-center gap-3">
			@atoms.Button(atoms.ButtonProps{Label: "保存", Variant: atoms.ButtonPrimary, Type: "submit"})
			@atoms.Spinner("settings-spinner")
		</div>
	</form>
}
