package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func logFilterClass(active bool) string {
	base := "rounded-md border px-3 py-1.5 text-sm font-medium "
	if active {
		return base + "border-indigo-600 bg-indigo-600 text-white"
	}
	return base + "border-slate-300 bg-white text-slate-700 hover:bg-slate-50"
}

func logFilterAttrs(active bool) atoms.Attrs {
	if active {
		return atoms.Attrs{"aria-current": "true"}
	}
	return nil
}

// logPagerLink はログのページ送りのリンク（#app-log だけを差し替え、URL を更新する）。
templ logPagerLink(url, label string, attrs atoms.Attrs) {
	<a
		href={ templ.SafeURL(url) }
		class="rounded-md border border-slate-300 bg-white px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50"
		hx-get={ url }
		hx-target="#app-log"
		hx-swap="outerHTML"
		hx-push-url="true"
		{ attrs... }
	>{ label }</a>
}

// AppLog はアプリのログ（FR-H13）。レベルの絞り込み・新しい順の表・ページ送り。読み取り専用で、ポーリングの対象ではない。
// 絞り込みとページ送りのリンクは #app-log を差し替える（HX-Request のフラグメント）。
templ AppLog(v view.AppLog) {
	<div id="app-log" class="space-y-3" data-log-filter={ v.Filter }>
		<nav class="flex flex-wrap items-center gap-2" aria-label="レベルの絞り込み" data-log-filters>
			<span class="text-sm text-slate-600">レベル:</span>
			for _, f := range v.Filters {
				<a
					href={ templ.SafeURL(f.URL) }
					class={ logFilterClass(f.Active) }
					hx-get={ f.URL }
					hx-target="#app-log"
					hx-swap="outerHTML"
					hx-push-url="true"
					data-log-filter-link={ f.Code }
					{ logFilterAttrs(f.Active)... }
				>{ f.Label }</a>
			}
		</nav>
		if len(v.Rows) == 0 {
			<p class="rounded-lg border border-dashed border-slate-300 bg-white px-4 py-8 text-center text-sm text-slate-500" data-empty="app-log">
				表示できるログはありません。
			</p>
		} else {
			<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
				<table class="min-w-full divide-y divide-slate-200 text-sm">
					<thead class="bg-slate-50 text-left text-xs font-semibold text-slate-600">
						<tr>
							<th scope="col" class="px-3 py-2">日時</th>
							<th scope="col" class="px-3 py-2">レベル</th>
							<th scope="col" class="px-3 py-2">内容</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, r := range v.Rows {
							<tr data-log-level={ r.Level }>
								<td class="whitespace-nowrap px-3 py-2 align-top text-slate-700">{ r.Time }</td>
								<td class="px-3 py-2 align-top">
									@atoms.Badge(badgeTone(r.LevelTone), r.Level)
								</td>
								<td class="px-3 py-2 align-top">
									<div class="break-words font-medium text-slate-800">{ r.Message }</div>
									if len(r.Attrs) > 0 {
										<dl class="mt-1 flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-slate-600">
											for _, a := range r.Attrs {
												<div class="break-all"><dt class="inline font-semibold">{ a.Key }</dt><dd class="ml-1 inline">{ a.Value }</dd></div>
											}
										</dl>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if v.PrevURL != "" || v.NextURL != "" {
			<nav class="flex items-center justify-between text-sm" aria-label="ページ送り" data-pager>
				if v.PrevURL != "" {
					@logPagerLink(v.PrevURL, "前へ（新しいログ）", atoms.Attrs{"data-pager-prev": ""})
				} else {
					<span></span>
				}
				<span class="text-slate-500" data-page={ strconv.Itoa(v.Page) }>{ strconv.Itoa(v.Page) } ページ目</span>
				if v.NextURL != "" {
					@logPagerLink(v.NextURL, "次へ（古いログ）", atoms.Attrs{"data-pager-next": ""})
				} else {
					<span></span>
				}
			</nav>
		}
	</div>
}
