package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func logFilterClass(active bool) string {
	base := "motion-hover inline-flex h-8 items-center rounded-full border px-3 text-sm "
	if active {
		return base + "border-border bg-accent-soft text-ink"
	}
	return base + "border-border bg-transparent text-ink hover:bg-accent-soft"
}

func logFilterAttrs(active bool) atoms.Attrs {
	if active {
		return atoms.Attrs{"aria-current": "true"}
	}
	return nil
}

// logPagerLink はログのページ送りのリンク（#app-log だけを差し替え、URL を更新する）。
templ logPagerLink(url, label string, attrs atoms.Attrs) {
	<a
		href={ templ.SafeURL(url) }
		class={ atoms.PagerButtonClass() }
		data-ripple
		hx-get={ url }
		hx-target="#app-log"
		hx-swap="outerHTML"
		hx-push-url="true"
		{ attrs... }
	>{ label }</a>
}

// AppLog はアプリのログ（FR-H13）。レベルの絞り込み・新しい順の表・ページ送り。読み取り専用で、ポーリングの対象ではない。
// 絞り込みとページ送りのリンクは #app-log を差し替える（HX-Request のフラグメント）。
templ AppLog(v view.AppLog) {
	<div id="app-log" class="space-y-3" data-log-filter={ v.Filter }>
		<nav class="flex flex-wrap items-center gap-2" aria-label="レベルの絞り込み" data-log-filters>
			<span class="text-sm text-ink">レベル:</span>
			for _, f := range v.Filters {
				<a
					href={ templ.SafeURL(f.URL) }
					class={ logFilterClass(f.Active) }
					hx-get={ f.URL }
					hx-target="#app-log"
					hx-swap="outerHTML"
					hx-push-url="true"
					data-log-filter-link={ f.Code }
					{ logFilterAttrs(f.Active)... }
				>{ f.Label }</a>
			}
		</nav>
		if len(v.Rows) == 0 {
			@molecules.EmptyState("app-log") {
				表示できるログはありません。
			}
		} else {
			<div class="overflow-x-auto rounded-lg border border-border bg-surface">
				<table class="min-w-full divide-y divide-border text-sm">
					<thead class="text-left text-xs font-semibold text-mute">
						<tr>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">日時</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">レベル</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">内容</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						for _, r := range v.Rows {
							<tr class="hover:bg-accent-soft" data-log-level={ r.Level }>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) align-top font-mono text-ink">{ r.Time }</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y) align-top">
									@atoms.Badge(badgeTone(r.LevelTone), r.Level)
								</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y) align-top">
									<div class="break-words text-ink">{ r.Message }</div>
									if len(r.Attrs) > 0 {
										<dl class="mt-1 flex flex-wrap gap-x-4 gap-y-2 text-sm text-ink">
											for _, a := range r.Attrs {
												<div class="break-all"><dt class="inline text-mute">{ a.Key }</dt><dd class="ml-1 inline">{ a.Value }</dd></div>
											}
										</dl>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if v.PrevURL != "" || v.NextURL != "" {
			<nav class="flex items-center justify-between text-sm" aria-label="ページ送り" data-pager>
				if v.PrevURL != "" {
					@logPagerLink(v.PrevURL, "前へ（新しいログ）", atoms.Attrs{"data-pager-prev": ""})
				} else {
					<span></span>
				}
				<span class="text-mute" data-page={ strconv.Itoa(v.Page) }>{ strconv.Itoa(v.Page) } ページ目</span>
				if v.NextURL != "" {
					@logPagerLink(v.NextURL, "次へ（古いログ）", atoms.Attrs{"data-pager-next": ""})
				} else {
					<span></span>
				}
			</nav>
		}
	</div>
}
