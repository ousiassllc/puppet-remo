package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// LaunchModePanel は起動の方式（ホワイトリスト / ブラックリスト）の表示と切り替え（FR-H12。launch.mode）。
// 方式を変えられるのはホスト所有者だけで、この GUI の画面にしかない（MCP・Web UI には経路が無い。NFR-S20）。
// ブラックリスト方式へは確認モーダルを経る（切り替えると、拒否リスト以外のアプリを AI が起動できるようになるため）。
templ LaunchModePanel(v view.LaunchModePanel) {
	<section id="launch-mode" class="space-y-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm" data-launch-mode={ launchModeName(v) }>
		<h2 class="text-sm font-semibold text-slate-800">起動の方式</h2>
		if v.Denylist {
			<p class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900" role="alert" data-mode-note="denylist">
				<strong>ブラックリスト方式</strong>: 下の「拒否リスト」に載せたアプリ以外は、リモートの AI が <code>launch_app</code> にパスを渡して何でも起動できます。登録済みのアプリも <code>app_id</code> で引き続き起動できます（拒否リストに当たるものは起動できません）。
			</p>
			<div>
				@atoms.Button(atoms.ButtonProps{Label: "ホワイトリスト方式に戻す", Variant: atoms.ButtonSecondary, Attrs: atoms.Attrs{
					"hx-put": v.ActionURL, "hx-vals": `{"mode":"allowlist"}`, "hx-target": "#launch-mode", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
				}})
			</div>
		} else {
			<p class="text-sm text-slate-600" data-mode-note="allowlist">
				<strong>ホワイトリスト方式（既定）</strong>: 下の一覧に登録したアプリだけが起動でき、ほかはすべて拒否します。
			</p>
			<div>
				@atoms.Button(atoms.ButtonProps{Label: "ブラックリスト方式に切り替える…", Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
					"hx-get": v.ConfirmURL, "hx-target": "#modal-root", "hx-swap": "innerHTML",
				}})
			</div>
		}
	</section>
}

func launchModeName(v view.LaunchModePanel) string {
	if v.Denylist {
		return "denylist"
	}
	return "allowlist"
}

// deniedSectionAttrs は、応答に添えて差し替える（OOB）ときの属性。
func deniedSectionAttrs(v view.DeniedSection) atoms.Attrs {
	if v.OOB {
		return atoms.Attrs{"hx-swap-oob": "true"}
	}
	return nil
}

// deniedFormAttrs は拒否リストの追加・編集フォームの hx-* 属性。成功も検証エラー（422）も、拒否リスト全体（#denied-section）を差し替える。
func deniedFormAttrs(put bool, url string) atoms.Attrs {
	a := atoms.Attrs{
		"hx-target": "#denied-section", "hx-swap": "outerHTML", "hx-target-422": "#denied-section", "hx-disabled-elt": "find button[type=submit]",
	}
	if put {
		a["hx-put"] = url
	} else {
		a["hx-post"] = url
	}
	return a
}

// DeniedSection は拒否リストの一覧と追加フォーム（FR-H12）。拒否リストはブラックリスト方式のときだけ効く。
// 入力は実行ファイルのパス（実体のパスで照合。リンク・8.3 短縮名を解決する）か、フォルダーを付けない実行ファイル名（どこにあっても当たる）。
templ DeniedSection(v view.DeniedSection) {
	<section id="denied-section" class="space-y-4" data-denied-active={ strconv.FormatBool(v.Active) } { deniedSectionAttrs(v)... }>
		<div>
			<h2 class="text-sm font-semibold text-slate-800">拒否リスト</h2>
			<p class="mt-1 text-sm text-slate-600">
				ブラックリスト方式のときだけ効きます（ホワイトリスト方式では使われません）。リストに当たるアプリは、パス指定でも登録済みの <code>app_id</code> でも起動できません。
				パスで登録すると実体のパス（シンボリックリンク・ジャンクション・8.3 の短い名前を解決したもの）で照合し、実行ファイル名（例: <code>cmd.exe</code>）で登録するとどのフォルダーにあっても名前で照合します。
				大文字小文字は区別しません。ファイルをコピーして別の名前にしたものは名前では見分けられません。
			</p>
			if !v.Active {
				<p class="text-xs text-slate-500" data-denied-inactive>いまはホワイトリスト方式なので、この拒否リストは使われていません。</p>
			}
			<p class="mt-1 text-xs text-slate-500" data-denied-count={ strconv.Itoa(v.Count) }>登録 { strconv.Itoa(v.Count) } / { strconv.Itoa(v.Max) } 件</p>
		</div>
		if len(v.Rows) == 0 {
			<p class="rounded-lg border border-dashed border-slate-300 bg-white px-4 py-6 text-center text-sm text-slate-500" data-empty="denied">拒否するアプリはまだ登録されていません。</p>
		}
		<ul class="space-y-2">
			for _, row := range v.Rows {
				if row.Editing {
					<li class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm" data-denied={ row.ID }>
						@deniedEditForm(row, v.ListURL)
					</li>
				} else {
					<li class="flex flex-wrap items-center gap-2 rounded-lg border border-slate-200 bg-white p-3 shadow-sm" data-denied={ row.ID }>
						<span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600" data-denied-kind>
							if row.IsPath {
								パス
							} else {
								実行ファイル名
							}
						</span>
						<code class="min-w-0 flex-1 break-all rounded bg-slate-100 px-1 py-0.5 text-xs" data-denied-value>{ row.Value }</code>
						@atoms.Button(atoms.ButtonProps{Label: "編集", Variant: atoms.ButtonSecondary, Attrs: atoms.Attrs{
							"hx-get": row.EditURL, "hx-target": "#denied-section", "hx-swap": "outerHTML",
						}})
						@atoms.Button(atoms.ButtonProps{Label: "削除", Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
							"hx-get": row.DeleteConfirm, "hx-target": "#modal-root", "hx-swap": "innerHTML",
						}})
					</li>
				}
			}
		</ul>
		<form
			id="denied-form-new"
			novalidate
			class="space-y-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm"
			data-denied-form="new"
			{ deniedFormAttrs(false, v.AddURL)... }
		>
			<h3 class="text-sm font-semibold text-slate-800">拒否リストに追加</h3>
			@deniedValueField("denied-form-new", v.AddValue, v.AddError)
			<div class="flex items-center gap-3">
				@atoms.Button(atoms.ButtonProps{Label: "追加", Variant: atoms.ButtonPrimary, Type: "submit"})
			</div>
		</form>
	</section>
}

templ deniedEditForm(row view.DeniedRow, cancelURL string) {
	<form
		id={ "denied-form-" + row.ID }
		novalidate
		class="space-y-3"
		data-denied-form="edit"
		{ deniedFormAttrs(true, row.ActionURL)... }
	>
		@deniedValueField("denied-form-"+row.ID, row.EditValue, row.EditError)
		<div class="flex items-center gap-3">
			@atoms.Button(atoms.ButtonProps{Label: "保存", Variant: atoms.ButtonPrimary, Type: "submit"})
			@atoms.Button(atoms.ButtonProps{Label: "キャンセル", Variant: atoms.ButtonSecondary, Attrs: atoms.Attrs{
				"hx-get": cancelURL, "hx-target": "#denied-section", "hx-swap": "outerHTML",
			}})
		</div>
	</form>
}

// deniedValueField は拒否リストの入力欄（パスか実行ファイル名の 1 つ）。
templ deniedValueField(formID, value, errMsg string) {
	@molecules.FormField(formID+"-value", "パスまたは実行ファイル名", `ドライブ文字で始まる絶対パスの .exe（例: C:\Windows\System32\cmd.exe）か、フォルダーを付けない実行ファイル名（例: cmd.exe）。`, errMsg) {
		@atoms.Input(atoms.InputProps{ID: formID + "-value", Name: "value", Value: value, Required: true, Invalid: errMsg != "", Placeholder: "cmd.exe", Attrs: atoms.Attrs{"autocomplete": "off", "spellcheck": "false"}})
	}
}
