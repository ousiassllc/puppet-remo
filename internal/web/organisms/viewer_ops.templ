package organisms

import (
	"encoding/json"
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// ViewerOps は操作権を持つ間だけ出す、クリップボードとショートカット送信（FR-W06・W07）。
// 持っていないときは中身を描画しない（状態駆動）。#viewer-ops はリースパネルの応答に OOB で添えて更新する。
templ ViewerOps(v view.ViewerOps) {
	<div id="viewer-ops" class="space-y-4">
		@viewerOpsBody(v)
	</div>
}

// ViewerOpsOOB はリースパネルの応答に添えて、#viewer-ops を差し替える（OOB）。
templ ViewerOpsOOB(v view.ViewerOps) {
	<div id="viewer-ops" class="space-y-4" hx-swap-oob="true">
		@viewerOpsBody(v)
	</div>
}

templ viewerOpsBody(v view.ViewerOps) {
	if v.Enabled {
		@ClipboardPanel(v.Scoped)
		@KeyMenu(v.Keys)
	}
}

// ClipboardPanel はクリップボードの手動送受信（FR-W07）。HTTP で配信するため navigator.clipboard は使わない。
// 送信は専用の入力欄（貼り付けは入力欄の標準の貼り付け）から、取得は表示欄に出して利用者が手動でコピーする。
templ ClipboardPanel(scoped bool) {
	<section id="clipboard-panel" aria-label="クリップボード">
		@molecules.Card("クリップボード") {
			<div class="space-y-3">
				<form
					class="space-y-2"
					novalidate
					hx-post="/viewer/clipboard/send"
					hx-target="#clipboard-status"
					hx-swap="innerHTML"
					hx-disabled-elt="find button[type=submit]"
				>
					<label for="clipboard-text" class="block text-sm font-medium text-slate-700">ホストへ送るテキスト</label>
					@atoms.Textarea(atoms.TextareaProps{ID: "clipboard-text", Name: "text", Placeholder: "ここに貼り付け（Ctrl+V）または入力して、送信します", Rows: 3})
					@atoms.Button(atoms.ButtonProps{Label: "ホストのクリップボードへ送信", Variant: atoms.ButtonPrimary, Type: "submit"})
				</form>
				if scoped {
					<p class="text-xs text-slate-500" data-clipboard-write-only>ウィンドウを選んだ操作中は、クリップボードの読み取りは使えません（書き込みだけ使えます）。</p>
				} else {
					<div class="space-y-2">
						@atoms.Button(atoms.ButtonProps{Label: "ホストのクリップボードを取得", Variant: atoms.ButtonSecondary, Attrs: atoms.Attrs{
							"hx-post": "/viewer/clipboard/fetch", "hx-target": "#clipboard-result", "hx-swap": "innerHTML", "hx-disabled-elt": "this",
						}})
						<div id="clipboard-result"></div>
					</div>
				}
				<div id="clipboard-status" role="status" aria-live="polite" class="text-sm text-slate-600"></div>
			</div>
		}
	</section>
}

// ClipboardSent は送信できたことの応答。送ったテキストは返さない（文字数だけ）。
templ ClipboardSent(chars int) {
	<span data-clipboard-sent>ホストのクリップボードへ送信しました（{ strconv.Itoa(chars) } 文字）。</span>
}

// ClipboardFetched はホストのクリップボードの内容を、読み取り専用の表示欄に出す。利用者が選択して手動でコピーする。
templ ClipboardFetched(text string) {
	<label for="clipboard-fetched" class="block text-sm font-medium text-slate-700">ホストのクリップボード（選択してコピーしてください）</label>
	@atoms.Textarea(atoms.TextareaProps{ID: "clipboard-fetched", Name: "fetched", Value: text, Rows: 4, Attrs: atoms.Attrs{"readonly": true, "data-clipboard-fetched": true}})
}

func keyAttrs(k view.KeyMenuItem) atoms.Attrs {
	if k.Disabled {
		return atoms.Attrs{"disabled": true, "aria-disabled": "true", "data-key-disabled": true, "title": "ウィンドウを選んだ操作中は使えません"}
	}
	vals, err := json.Marshal(map[string]string{"keys": k.Keys})
	if err != nil { // map[string]string は常に変換できる
		panic(err)
	}
	return atoms.Attrs{
		"hx-post": "/viewer/keys/send", "hx-vals": string(vals), "hx-target": "#keys-status", "hx-swap": "innerHTML", "hx-disabled-elt": "this",
	}
}

// KeyMenu はブラウザが先取りするショートカットの送信メニュー（FR-W06）。Ctrl+Alt+Del は含めない（送れない）。
templ KeyMenu(items []view.KeyMenuItem) {
	<section id="key-menu" aria-label="ショートカットの送信">
		@molecules.Card("ショートカットを送信") {
			<p class="mb-2 text-xs text-slate-500">ブラウザが先に処理するキー操作を、ホストへ送ります。</p>
			<div class="flex flex-wrap gap-2">
				for _, k := range items {
					@atoms.Button(atoms.ButtonProps{Label: k.Label, Variant: atoms.ButtonSecondary, Attrs: keyAttrs(k)})
				}
			</div>
			<div id="keys-status" role="status" aria-live="polite" class="mt-2 text-sm text-slate-600"></div>
		}
	</section>
}

// KeysSent はショートカットを送れたことの応答。
templ KeysSent(label string) {
	<span data-keys-sent>{ label } を送信しました。</span>
}
