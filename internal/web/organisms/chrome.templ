package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// HeaderKillSwitch はヘッダーのキルスイッチ状態バッジ（SSE の killswitch イベントと OOB の差し込み先 #header-killswitch の中身）。
// 画面の更新は GET /poll の OOB（HeaderKillSwitchOOB）が行う。
templ HeaderKillSwitch(active bool) {
	if active {
		@atoms.Badge(atoms.BadgeDanger, "キルスイッチ発動中")
	} else {
		@atoms.Badge(atoms.BadgeOK, "稼働中")
	}
}

// Header は全画面共通のヘッダー。
templ Header(h view.Header) {
	<header class="flex h-14 items-center justify-between border-b border-border bg-surface px-4 md:px-6">
		<div class="flex items-center gap-2">
			@navToggle()
			<span class="text-base text-ink">puppet-remo ホスト</span>
		</div>
		<div id="header-killswitch">
			@HeaderKillSwitch(h.KillSwitchActive)
		</div>
	</header>
}

// navToggle は狭い幅（md 未満）でだけ出す、ナビのドロワーを開閉するハンバーガー（P0）。開閉は app.ts が body の data-nav-open で持つ。
templ navToggle() {
	<button type="button" class="motion-hover inline-flex size-10 shrink-0 items-center justify-center rounded-md text-ink hover:bg-accent-soft md:hidden" aria-label="メニューを開く" aria-controls="sidebar-nav" aria-expanded="false" data-nav-toggle data-ripple>
		@atoms.Icon(atoms.IconMenu, atoms.IconLG)
	</button>
}

// NavScrim はドロワーを開いたときの暗幕（O1）。クリックで閉じる（app.ts）。狭い幅のときだけ働く（md 以上はナビが常時見える）。
// ナビの OOB の差し替え（Sidebar）に巻き込まれないよう、ナビの外に置く。
templ NavScrim() {
	<div id="nav-scrim" class="nav-scrim fixed inset-0 z-(--z-drawer) bg-scrim md:hidden" aria-hidden="true"></div>
}

// HeaderKillSwitchOOB はアクションの応答・GET /poll の応答に添えて、ヘッダーのバッジを更新する（OOB）。
templ HeaderKillSwitchOOB(active bool) {
	<div id="header-killswitch" hx-swap-oob="innerHTML">
		@HeaderKillSwitch(active)
	</div>
}

// RequestsBadge はサイドバーの接続要求の件数（0 件なら何も出さない）。通知バッジ数（P1）: --accent 地 + --bone 字・11px Mono・最小 18px。99 を超える件数は 99+ にする。
templ RequestsBadge(n int) {
	if n > 0 {
		<span class="ml-auto inline-flex h-4.5 min-w-4.5 items-center justify-center rounded-full bg-accent px-1 font-mono text-2xs text-bone" data-pending-count={ strconv.Itoa(n) }>{ badgeCount(n) }</span>
	}
}

func badgeCount(n int) string {
	if n > 99 {
		return "99+"
	}
	return strconv.Itoa(n)
}

// RequestsBadgeOOB はアクションの応答・GET /poll の応答に添えて、件数バッジを更新する（OOB）。
templ RequestsBadgeOOB(n int) {
	<span id="nav-requests-badge" class="ml-auto" hx-swap-oob="innerHTML">
		@RequestsBadge(n)
	</span>
}

type navItem struct {
	Nav   view.Nav
	Label string
	URL   string
}

var navItems = []navItem{
	{view.NavDashboard, "ダッシュボード", "/"},
	{view.NavRequests, "接続要求", "/requests"},
	{view.NavClients, "クライアント", "/clients"},
	{view.NavApps, "起動許可アプリ", "/apps"},
	{view.NavTasks, "タスク", "/tasks"},
	{view.NavAudit, "監査ログ", "/audit"},
	{view.NavAgent, "エージェント", "/agent"},
	{view.NavSettings, "設定", "/settings"},
	{view.NavUpdate, "更新", "/update"},
	{view.NavLogs, "ログ", "/logs"},
}

func navLinkClass(active bool) string {
	base := "motion-hover flex h-10 items-center gap-2 rounded-sm px-3 text-base "
	if active {
		return base + "bg-accent-soft text-ink"
	}
	return base + "text-mute hover:bg-accent-soft hover:text-ink"
}

func navLinkAttrs(active bool) atoms.Attrs {
	if active {
		return atoms.Attrs{"aria-current": "page"}
	}
	return nil
}

func oobAttrs(oob bool) atoms.Attrs {
	if oob {
		return atoms.Attrs{"hx-swap-oob": "true"}
	}
	return nil
}

// Sidebar はホスト GUI のナビゲーション。ページ遷移は hx-boost で #main だけを差し替える（§5.4）。
// ブートされた遷移の応答は oob = true で添えて、現在のページの強調を更新する。
// md（768px）未満では左のドロワー（固定・幅 約 78%。ハンバーガー（navToggle）で開き、スクラム・リンク・Esc で閉じる。P0）、md 以上は常時見える左のカラム。
// 開閉の状態は body の data-nav-open（app.ts）で、見た目は app.css の .nav-drawer。
templ Sidebar(c view.Chrome, oob bool) {
	<nav id="sidebar-nav" class="nav-drawer fixed inset-y-0 left-0 z-(--z-drawer) w-[78%] max-w-[320px] shrink-0 space-y-2 overflow-y-auto border-r border-border bg-surface p-3 md:static md:z-auto md:w-60 md:overflow-visible" aria-label="メイン" { oobAttrs(oob)... }>
		<p class="px-3 pb-2 pt-1 text-xs text-mute">メニュー</p>
		for _, it := range navItems {
			<a
				href={ templ.SafeURL(it.URL) }
				class={ navLinkClass(it.Nav == c.Active) }
				hx-boost="true"
				hx-target="#main"
				hx-target-error="#main"
				hx-swap="innerHTML"
				{ navLinkAttrs(it.Nav == c.Active)... }
			>
				<span>{ it.Label }</span>
				if it.Nav == view.NavRequests {
					<span id="nav-requests-badge" class="ml-auto">
						@RequestsBadge(c.Header.PendingRequests)
					</span>
				}
			</a>
		}
	</nav>
}

// ToastRoot はトーストの置き場（画面下の中央・端から 24px）。完了の短い通知（OOB の ToastOOB と GET /poll の応答）がここへ追加する。
// 同時に表示するのは 1 つで、新しいものが前を置き換える（app.ts）。エラーは AlertRoot のインラインアラートに出し、トーストには出さない。
templ ToastRoot() {
	<div id="toast-root" class="pointer-events-none fixed bottom-6 left-1/2 z-(--z-toast) flex max-w-[calc(100vw-3rem)] -translate-x-1/2 flex-col items-center" role="status"></div>
}

// AlertRoot はアクションの失敗・エラーのインラインアラートの置き場。応答（HX-Retarget: #alert-root・HX-Reswap: innerHTML と、
// GET /poll の応答の AlertOOB）が差し込み、新しいものが前を置き換える。class は配置の余白（ページごとに違う）。
// #alert-template は、サーバーの応答を介さないクライアント側のエラー（接続できない・ビューアの入力の拒否）を app.ts が同じ見た目で出すための雛形。
templ AlertRoot(class string) {
	<div id="alert-root" class={ "empty:hidden", class }></div>
	<template id="alert-template">
		@atoms.Alert(atoms.AlertProps{Tone: atoms.AlertDanger, Heading: "エラー", Dismissible: true, Template: true})
	</template>
}

// AlertOOB は GET /poll などの応答に添えて、#alert-root のアラートを差し替える（OOB）。
templ AlertOOB(p atoms.AlertProps) {
	<div id="alert-root" hx-swap-oob="innerHTML">
		@atoms.Alert(p)
	</div>
}

// LivePoller は最新の状態を取りに行く。GET /poll を 3 秒ごとに呼び、応答の OOB のフラグメントで各領域を差し替える（swap は none）。
// hx-include は、いま表示している領域の隠し入力（data-poll-rev。描画した状態の版）を送り返す。サーバーは版が変わった領域だけを
// 差し替え、表示していない領域は送らない。
templ LivePoller() {
	<div id="live-poll" aria-hidden="true" hx-get="/poll" hx-trigger="every 3s" hx-swap="none" hx-include="[data-poll-rev]"></div>
}

// ToastOOB はアクションの応答・GET /poll の応答に添えて、トーストを追加する（OOB）。
templ ToastOOB(t view.Toast) {
	<div hx-swap-oob="beforeend:#toast-root">
		@atoms.Toast(t)
	</div>
}

// ModalRoot は確認モーダルの置き場。
templ ModalRoot() {
	<div id="modal-root"></div>
}

// ModalClear は確定のアクションの応答に添えて、確認モーダルを閉じる（OOB）。
templ ModalClear() {
	<div id="modal-root" hx-swap-oob="true"></div>
}
