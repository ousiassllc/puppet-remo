package organisms

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func auditSelectOptions(opts []view.AuditFilterOption) []atoms.SelectOption {
	out := make([]atoms.SelectOption, len(opts))
	for i, o := range opts {
		out[i] = atoms.SelectOption{Value: o.Value, Label: o.Label, Selected: o.Selected}
	}
	return out
}

// AuditFilters は監査ログの絞り込みフォーム（日時の範囲・クライアント・種別・結果・イベント名。FR-AU05）。
// 送信は #audit-list を差し替えて URL を更新する。値が不正なとき（422）は、同じ #audit-list に項目別のメッセージ付きで再描画する
// （settings.templ の SettingsForm と同じく、ブラウザの入力検証は止めてサーバーが検証する）。
// 日時は RFC 3339 の文字列で入力する（API 仕様 §7.3 の from / to と同じ）。
templ AuditFilters(f view.AuditFilters) {
	<form
		class="space-y-3 rounded-lg border border-border bg-surface p-4"
		method="get"
		action="/audit"
		novalidate
		aria-label="絞り込み"
		data-audit-filters
		hx-get="/audit"
		hx-target="#audit-list"
		hx-target-422="#audit-list"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-disabled-elt="find button[type=submit]"
	>
		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			@molecules.FormField("audit-from", "開始日時", "RFC 3339（例: 2026-11-02T09:00:00+09:00）。この日時以降。", f.Errors.From) {
				@atoms.Input(atoms.InputProps{ID: "audit-from", Name: "from", Value: f.From, Placeholder: "2026-11-02T09:00:00+09:00", Invalid: f.Errors.From != "", Attrs: atoms.Attrs{"autocomplete": "off"}})
			}
			@molecules.FormField("audit-to", "終了日時", "RFC 3339。この日時以前。", f.Errors.To) {
				@atoms.Input(atoms.InputProps{ID: "audit-to", Name: "to", Value: f.To, Placeholder: "2026-11-02T18:00:00+09:00", Invalid: f.Errors.To != "", Attrs: atoms.Attrs{"autocomplete": "off"}})
			}
			@molecules.FormField("audit-q", "イベント名", "部分一致（例: lease、tool.left_click）。", "") {
				@atoms.Input(atoms.InputProps{ID: "audit-q", Name: "q", Value: f.Q, Attrs: atoms.Attrs{"autocomplete": "off"}})
			}
			@molecules.FormField("audit-client", "クライアント", "削除済みのクライアントの行は、名前の記録だけが残ります。", "") {
				@atoms.Select("audit-client", "client_id", auditSelectOptions(f.Clients))
			}
			@molecules.FormField("audit-kind", "種別", "", f.Errors.Kind) {
				@atoms.Select("audit-kind", "kind", auditSelectOptions(f.Kinds))
			}
			@molecules.FormField("audit-result", "結果", "", f.Errors.Result) {
				@atoms.Select("audit-result", "result", auditSelectOptions(f.Results))
			}
		</div>
		if f.Limit != "" {
			<input type="hidden" name="limit" value={ f.Limit }/>
		}
		if f.Errors.Paging != "" {
			<p class="text-xs text-danger" role="alert" data-field-error="audit-paging">{ f.Errors.Paging }</p>
		}
		<div class="flex items-center gap-3">
			@atoms.Button(atoms.ButtonProps{Label: "絞り込む", Variant: atoms.ButtonPrimary, Type: "submit"})
			<a href="/audit" class="text-sm text-ink hover:underline" hx-get="/audit" hx-target="#audit-list" hx-swap="outerHTML" hx-push-url="true" data-audit-reset>条件をクリア</a>
		</div>
	</form>
}

// auditThumbCell はサムネイルの有無の表示。
templ auditThumbCell(has bool) {
	if has {
		@atoms.Badge(atoms.BadgeNeutral, "あり")
	} else {
		<span class="text-mute">-</span>
	}
}

// AuditList は監査ログの一覧（絞り込みフォーム・新しい順の表・「次へ」。FR-AU05）。読み取り専用で、ポーリングの対象ではない。
// 絞り込みと「次へ」は #audit-list を差し替える（HX-Request のフラグメント）。戻るはブラウザの履歴（hx-push-url）。
// 値が表示されるのは AuditReader が伏せたあとのものだけで、templ が HTML エスケープする。
templ AuditList(v view.AuditList) {
	<div id="audit-list" class="space-y-3">
		@AuditFilters(v.Filters)
		if len(v.Rows) == 0 {
			// 値が不正で検索しなかったとき（422）は、「該当なし」とは言わない。
			if !v.Filters.Errors.Any() {
				@molecules.EmptyState("audit-list") {
					条件に合う監査ログはありません。
				}
			}
		} else {
			<div class="overflow-x-auto rounded-lg border border-border bg-surface">
				<table class="min-w-full divide-y divide-border text-sm">
					<thead class="text-left text-xs font-semibold text-mute">
						<tr>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">日時</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">クライアント</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">種別</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">イベント</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">結果</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y) text-right">所要時間</th>
							<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">画像</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						for _, r := range v.Rows {
							<tr class="hover:bg-accent-soft" data-audit-row={ r.DetailURL } data-result={ r.Result }>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.Time }</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.Client }</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y) text-ink">{ r.Kind }</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y)">
									<a
										href={ templ.SafeURL(r.DetailURL) }
										class="link"
										hx-boost="true"
										hx-target="#main"
										hx-target-error="#main"
										hx-swap="innerHTML"
									>{ r.Event }</a>
								</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y)">
									@atoms.Badge(badgeTone(r.ResultTone), r.Result)
								</td>
								<td class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-right font-mono text-ink">{ r.Duration }</td>
								<td class="px-(--table-pad-x) py-(--table-pad-y)">
									@auditThumbCell(r.HasThumb)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if v.NextURL != "" {
			<nav class="flex items-center justify-end text-sm" aria-label="ページ送り" data-pager>
				<a
					href={ templ.SafeURL(v.NextURL) }
					class={ atoms.ButtonClass(atoms.ButtonSecondary, true) }
		data-ripple
					hx-get={ v.NextURL }
					hx-target="#audit-list"
					hx-swap="outerHTML"
					hx-push-url="true"
					data-pager-next
				>次へ（古いログ）</a>
			</nav>
		}
	</div>
}

// AuditDetail は監査ログ 1 件の詳細（FR-AU05）。引数はキー・値の表、サムネイルは <img>（同一オリジンの画像。CSP の img-src 'self'）。
templ AuditDetail(v view.AuditDetail) {
	<div class="space-y-4" data-audit-detail={ v.Event }>
		<dl class="grid gap-x-6 gap-y-2 rounded-lg border border-border bg-surface p-4 text-sm sm:grid-cols-2">
			@auditField("日時", v.Time, "time")
			@auditField("種別", v.Kind, "kind")
			@auditField("イベント", v.Event, "event")
			@auditField("操作主体", v.Actor, "actor")
			@auditField("クライアント", v.Client, "client")
			@auditField("セッション", v.SessionID, "session")
			@auditField("リース", v.LeaseID, "lease")
			@auditField("ツール", v.Tool, "tool")
			<div class="flex gap-2">
				<dt class="w-28 shrink-0 text-mute">結果</dt>
				<dd data-audit-field="result">
					@atoms.Badge(badgeTone(v.ResultTone), v.Result)
				</dd>
			</div>
			@auditField("エラーコード", v.ErrorCode, "error-code")
			@auditField("所要時間", v.Duration, "duration")
		</dl>
		<section class="space-y-2" aria-label="引数">
			<h2 class="text-base font-semibold text-ink">引数</h2>
			if len(v.Args) == 0 {
				@molecules.EmptyState("audit-args") {
					記録された引数はありません。
				}
			} else {
				<div class="overflow-x-auto rounded-lg border border-border bg-surface">
					<table class="min-w-full divide-y divide-border text-sm" data-audit-args>
						<thead class="text-left text-xs font-semibold text-mute">
							<tr>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">キー</th>
								<th scope="col" class="px-(--table-pad-x) py-(--table-pad-y)">値</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, a := range v.Args {
								<tr class="hover:bg-accent-soft">
									<th scope="row" class="whitespace-nowrap px-(--table-pad-x) py-(--table-pad-y) text-left text-ink">{ a.Key }</th>
									<td class="break-all px-(--table-pad-x) py-(--table-pad-y) text-ink">{ a.Value }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section class="space-y-2" aria-label="サムネイル">
			<h2 class="text-base font-semibold text-ink">サムネイル</h2>
			if v.ThumbURL != "" {
				<img
					src={ v.ThumbURL }
					alt="操作の直後の縮小スクリーンショット"
					width={ v.ThumbW }
					height={ v.ThumbH }
					class="max-w-full rounded-lg border border-border bg-surface"
					data-audit-thumb
				/>
			} else {
				@molecules.EmptyState("audit-thumb") {
					{ v.ThumbNote }
				}
			}
		</section>
		<a
			href={ templ.SafeURL(v.BackURL) }
			class="text-sm link"
			hx-boost="true"
			hx-target="#main"
			hx-target-error="#main"
			hx-swap="innerHTML"
		>監査ログの一覧へ戻る</a>
	</div>
}

// auditField は詳細の項目 1 つ。値が空の項目は描画しない（無い項目を「-」で埋めない）。
templ auditField(label, value, name string) {
	if value != "" {
		<div class="flex gap-2">
			<dt class="w-28 shrink-0 text-mute">{ label }</dt>
			<dd class="break-all text-ink" data-audit-field={ name }>{ value }</dd>
		</div>
	}
}
