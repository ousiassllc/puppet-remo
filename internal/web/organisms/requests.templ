package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func approvalOptions(opts []view.ApprovalModeOption) []atoms.SelectOption {
	out := make([]atoms.SelectOption, len(opts))
	for i, o := range opts {
		out[i] = atoms.SelectOption{Value: o.Value, Label: o.Label, Selected: o.Selected}
	}
	return out
}

// ConnectionRequestList は接続要求の一覧（許可 / 拒否。FR-H03）。
// 承認モードは M1 では「常時承認」だけを選択肢に出す。許可・拒否の応答と GET /poll の応答（ConnectionRequestListOOB）で差し替える。
templ ConnectionRequestList(v view.RequestList) {
	@connectionRequestList(v, false)
}

// ConnectionRequestListOOB は GET /poll の応答に添えて、接続要求の一覧を差し替える（OOB）。
templ ConnectionRequestListOOB(v view.RequestList) {
	@connectionRequestList(v, true)
}

// connectionRequestList の隠し入力（data-poll-rev）は、描画した一覧の版。ポーリングが送り返し、変わっていなければサーバーは差し替えない
// （入力中のフォームをポーリングで消さないため）。
templ connectionRequestList(v view.RequestList, oob bool) {
	<div id="request-list" class="space-y-4" { oobAttrs(oob)... }>
		<input type="hidden" name="rev_requests" value={ v.Rev } data-poll-rev/>
		if len(v.Rows) == 0 {
			<p class="rounded-lg border border-dashed border-slate-300 bg-white px-4 py-8 text-center text-sm text-slate-500" data-empty="requests">
				未処理の接続要求はありません。未登録のデバイスが接続しようとすると、ここに表示されます。
			</p>
		}
		for _, r := range v.Rows {
			<article class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm" data-request={ r.ID }>
				<div class="flex flex-wrap items-baseline justify-between gap-2">
					<h3 class="text-sm font-semibold text-slate-800">{ r.DisplayName }</h3>
					<span class="text-xs text-slate-500">{ strconv.Itoa(r.Count) } 回の要求 ・ 初回 { r.FirstSeen } ・ 最終 { r.LastSeen }</span>
				</div>
				<p class="mt-1 text-xs text-slate-500">
					ユーザー { r.LoginName } ・ 接続元 <code class="rounded bg-slate-100 px-1 py-0.5">{ r.RemoteIP }</code> ・ { r.ExpiresAt } まで有効
				</p>
				<form
					class="mt-3 grid gap-3 sm:grid-cols-2"
					hx-post={ r.ApproveURL }
					hx-target="#request-list"
					hx-swap="outerHTML"
					hx-disabled-elt="find button"
				>
					@molecules.FormField("name-"+r.ID, "表示名", "", "") {
						@atoms.Input(atoms.InputProps{ID: "name-" + r.ID, Name: "display_name", Value: r.DisplayName})
					}
					@molecules.FormField("mode-"+r.ID, "承認モード", "リースを取得するときの承認の方式です。", "") {
						@atoms.Select("mode-"+r.ID, "approval_mode", approvalOptions(r.Modes))
					}
					<fieldset class="space-y-1 sm:col-span-2">
						<legend class="text-sm font-medium text-slate-700">使える機能</legend>
						<label class="mr-4 inline-flex items-center gap-2 text-sm">
							@atoms.Checkbox("web-"+r.ID, "web_enabled", true)
							Web
						</label>
						<label class="mr-4 inline-flex items-center gap-2 text-sm">
							@atoms.Checkbox("mcp-"+r.ID, "mcp_enabled", true)
							MCP
						</label>
						<label class="inline-flex items-center gap-2 text-sm">
							@atoms.Checkbox("agent-"+r.ID, "agent_enabled", false)
							エージェント
						</label>
					</fieldset>
					<div class="flex gap-2 sm:col-span-2">
						@atoms.Button(atoms.ButtonProps{Label: "許可", Variant: atoms.ButtonPrimary, Type: "submit"})
						@atoms.Button(atoms.ButtonProps{Label: "拒否", Variant: atoms.ButtonSecondary, Attrs: atoms.Attrs{
							"hx-post": r.DenyURL, "hx-target": "#request-list", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
							"hx-include": "this",
						}})
					</div>
				</form>
			</article>
		}
	</div>
}
