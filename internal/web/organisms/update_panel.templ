package organisms

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// UpdatePanel は更新のパネル（FR-H09）。現在の版・チャネル・適用方法・最後の確認・新版（署名検証の結果）と、「今すぐ確認」「更新する」。
// リリースノートなど GitHub の Release 由来の文字列は templ が HTML エスケープする。
// 「更新する」は、署名の検証に成功した新版があるときだけ出す（確認モーダルを経て POST /update/apply）。
templ UpdatePanel(v view.UpdatePanel) {
	<section id="update-panel" class="rounded-lg border border-slate-200 bg-white shadow-sm">
		<h2 class="border-b border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700">アプリの更新</h2>
		<div class="space-y-4 p-4">
			<dl class="grid grid-cols-1 gap-x-4 gap-y-1 text-sm sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-y-2">
				<dt class="text-slate-500">現在の版</dt>
				<dd class="mb-1 min-w-0 sm:mb-0"><code class="break-all rounded bg-slate-100 px-1.5 py-0.5 text-xs" data-field="current-version">{ v.CurrentVersion }</code></dd>
				<dt class="text-slate-500">チャネル</dt>
				<dd class="mb-1 sm:mb-0" data-field="channel">{ v.ChannelLabel }</dd>
				<dt class="text-slate-500">適用方法</dt>
				<dd class="mb-1 sm:mb-0" data-field="apply-mode">{ v.ApplyModeLabel }</dd>
				<dt class="text-slate-500">最後の確認</dt>
				<dd data-field="last-checked">
					if v.LastChecked == "" {
						<span class="text-slate-500">未確認</span>
					} else {
						{ v.LastChecked }
					}
				</dd>
			</dl>
			if !v.Updatable {
				<p class="rounded-md bg-slate-50 px-3 py-2 text-sm text-slate-600" role="status" data-update="not-updatable">
					この版（開発用のビルド）は、更新の確認も適用もしません。
				</p>
			}
			if v.Error != "" {
				<p class="rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-800" role="status" data-update="error">{ v.Error }</p>
			}
			if v.KeyNotConfigured {
				<p class="rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-800" role="status" data-update="key-unset">
					署名鍵が未設定のため、新しい版があっても適用できません（確認だけ行います）。
				</p>
			}
			if v.Updatable && v.Latest == nil && v.Error == "" && v.LastChecked != "" {
				<p class="text-sm text-slate-600" data-update="up-to-date">新しい版はありません。</p>
			}
			if v.Latest != nil {
				<div class="space-y-2 rounded-md border border-slate-200 p-3" data-update="latest">
					<div class="flex flex-wrap items-center gap-2">
						<span class="text-sm font-medium text-slate-800">新しい版: <code class="break-all rounded bg-slate-100 px-1.5 py-0.5 text-xs" data-field="latest-version">{ v.Latest.Version }</code></span>
						if v.Latest.Verified {
							@atoms.Badge(atoms.BadgeOK, "署名を確認済み")
						} else {
							@atoms.Badge(atoms.BadgeWarn, "適用できません")
						}
						if v.Latest.PublishedAt != "" {
							<span class="text-xs text-slate-500">{ v.Latest.PublishedAt } 公開</span>
						}
					</div>
					if !v.Latest.Verified && v.Latest.Reject != "" {
						<p class="text-sm text-amber-800" data-update="reject">{ v.Latest.Reject }</p>
					}
					if v.Latest.Notes != "" {
						<pre class="max-h-48 overflow-auto whitespace-pre-wrap break-words rounded bg-slate-50 p-2 text-xs text-slate-700" data-field="release-notes">{ v.Latest.Notes }</pre>
					}
				</div>
			}
			if v.Applying {
				<p class="rounded-md bg-indigo-50 px-3 py-2 text-sm text-indigo-800" role="status" data-update="applying">
					インストーラを起動しました。アプリを終了して更新します。
				</p>
			}
			if v.Updatable {
				<div class="flex flex-wrap items-center gap-3">
					@atoms.Button(atoms.ButtonProps{Label: "今すぐ確認", Variant: atoms.ButtonSecondary, Attrs: atoms.Attrs{
						"hx-post": "/update/check", "hx-target": "#update-panel", "hx-swap": "outerHTML",
						"hx-disabled-elt": "this", "hx-indicator": "#update-spinner",
					}})
					if v.CanApply && !v.Applying {
						@atoms.Button(atoms.ButtonProps{Label: "更新する", Variant: atoms.ButtonPrimary, Attrs: atoms.Attrs{
							"hx-get": v.ConfirmRoute, "hx-target": "#modal-root", "hx-swap": "innerHTML",
						}})
					}
					@atoms.Spinner("update-spinner")
				</div>
			}
		</div>
	</section>
}
