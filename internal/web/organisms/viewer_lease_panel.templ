package organisms

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func leaseButtonAttrs(url string) atoms.Attrs {
	return atoms.Attrs{"hx-post": url, "hx-target": "#lease-panel", "hx-swap": "outerHTML", "hx-disabled-elt": "this"}
}

// ViewerLeasePanel はビューアのリースパネル（FR-W08）。保持者の種別・名前・状態は常に出し、操作のボタンは
// 状態に合うものだけを描画する（状態駆動。frontend.md §4.3）: 空きなら「取得」、自分が保持なら「解放」、他者が保持なら「強制剥奪」。
// <remo-screen-viewer> が remo:lease-changed を発火すると、#viewer-root からそれを受けて GET /viewer/lease で自分を差し替える。
templ ViewerLeasePanel(v view.ViewerLease) {
	<div
		id="lease-panel"
		hx-get="/viewer/lease"
		hx-trigger="remo:lease-changed from:#viewer-root"
		hx-target="this"
		hx-swap="outerHTML"
	>
		@molecules.Card("操作権") {
			<div class="flex flex-wrap items-center gap-2" data-lease-state={ leaseState(v) }>
				if v.Pending {
					@molecules.LeasePendingBadge(v.HolderLabel, v.KindLabel)
					if v.PendingMine {
						@atoms.Badge(atoms.BadgeWarn, "あなた")
					}
				} else {
					@molecules.LeaseBadge(v.Held, v.HolderLabel, v.KindLabel)
				}
				if v.Mine {
					@atoms.Badge(atoms.BadgeOK, "あなた")
				}
				if v.ScopedProcess != "" {
					<span class="text-sm text-mute" data-lease-scope>対象: { v.ScopedProcess }</span>
				}
				if v.CanAcquire {
					@atoms.Button(atoms.ButtonProps{Label: "操作権を取得", Small: true, Variant: atoms.ButtonPrimary, Attrs: leaseButtonAttrs("/viewer/lease/acquire")})
				}
				if v.CanRelease {
					@atoms.Button(atoms.ButtonProps{Label: "解放", Small: true, Variant: atoms.ButtonSecondary, Attrs: leaseButtonAttrs("/viewer/lease/release")})
				}
				if v.CanRevoke {
					@atoms.Button(atoms.ButtonProps{Label: "強制剥奪", Small: true, Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{"hx-get": "/viewer/lease/revoke/confirm", "hx-target": "#modal-root", "hx-swap": "innerHTML"}})
				}
			</div>
			if v.Task != nil {
				<div class="mt-2">
					@atoms.Notice(atoms.AlertInfo, atoms.Attrs{"data-lease-task": true}) {
						<h3 class="text-sm font-semibold">AI エージェントのタスク実行中</h3>
						<dl class="space-y-2 text-sm">
							<div class="flex gap-2"><dt class="w-16 text-mute">状態</dt><dd data-task-status>{ v.Task.Status }</dd></div>
							<div class="flex gap-2"><dt class="w-16 text-mute">ステップ</dt><dd class="font-mono" data-task-steps>{ v.Task.Steps }</dd></div>
							<div class="flex gap-2"><dt class="w-16 text-mute">経過</dt><dd class="font-mono" data-task-elapsed>{ v.Task.Elapsed }（上限 { v.Task.MaxTime }）</dd></div>
							if v.Task.StartedAt != "" {
								<div class="flex gap-2"><dt class="w-16 text-mute">開始</dt><dd class="font-mono" data-task-started>{ v.Task.StartedAt }</dd></div>
							}
							<div class="flex gap-2"><dt class="w-16 text-mute">依頼元</dt><dd data-task-requester>{ v.Task.Requester }</dd></div>
						</dl>
					}
				</div>
			}
			if v.PendingMine {
				<div class="mt-2">
					@atoms.Notice(atoms.AlertWarning, atoms.Attrs{"role": "status", "data-lease-pending-message": true}) {
						ホストの承認を待っています。
					}
				</div>
			}
			<p class="mt-2 text-xs text-mute">この画面から Ctrl+Alt+Del は送れません。</p>
		}
	</div>
}

func leaseState(v view.ViewerLease) string {
	switch {
	case v.Pending:
		return "pending_approval"
	case !v.Held:
		return "idle"
	case v.Mine:
		return "mine"
	}
	return "other"
}
