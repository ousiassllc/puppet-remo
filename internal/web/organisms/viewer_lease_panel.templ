package organisms

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func leaseButtonAttrs(url string) atoms.Attrs {
	return atoms.Attrs{"hx-post": url, "hx-target": "#lease-panel", "hx-swap": "outerHTML", "hx-disabled-elt": "this"}
}

// ViewerLeasePanel はビューアのリースパネル（FR-W08）。保持者の種別・名前・状態は常に出し、操作のボタンは
// 状態に合うものだけを描画する（状態駆動。frontend.md §4.3）: 空きなら「取得」、自分が保持なら「解放」、他者が保持なら「強制剥奪」。
// <remo-screen-viewer> が remo:lease-changed を発火すると、#viewer-root からそれを受けて GET /viewer/lease で自分を差し替える。
templ ViewerLeasePanel(v view.ViewerLease) {
	<section
		id="lease-panel"
		class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm"
		aria-label="操作権"
		hx-get="/viewer/lease"
		hx-trigger="remo:lease-changed from:#viewer-root"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<h2 class="mb-2 text-sm font-semibold text-slate-700">操作権</h2>
		<div class="flex flex-wrap items-center gap-3" data-lease-state={ leaseState(v) }>
			@molecules.LeaseBadge(v.Held, v.HolderLabel, v.KindLabel)
			if v.Mine {
				@atoms.Badge(atoms.BadgeOK, "あなた")
			}
			if v.CanAcquire {
				@atoms.Button(atoms.ButtonProps{Label: "操作権を取得", Variant: atoms.ButtonPrimary, Attrs: leaseButtonAttrs("/viewer/lease/acquire")})
			}
			if v.CanRelease {
				@atoms.Button(atoms.ButtonProps{Label: "解放", Variant: atoms.ButtonSecondary, Attrs: leaseButtonAttrs("/viewer/lease/release")})
			}
			if v.CanRevoke {
				@atoms.Button(atoms.ButtonProps{Label: "強制剥奪", Variant: atoms.ButtonDanger, Attrs: leaseButtonAttrs("/viewer/lease/revoke")})
			}
		</div>
		<p class="mt-2 text-xs text-slate-500">この画面から Ctrl+Alt+Del は送れません。</p>
	</section>
}

func leaseState(v view.ViewerLease) string {
	switch {
	case !v.Held:
		return "idle"
	case v.Mine:
		return "mine"
	}
	return "other"
}
