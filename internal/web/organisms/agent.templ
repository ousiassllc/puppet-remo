package organisms

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

// APIKeyPanel は API キーの登録パネル（FR-H11、NFR-S14）。登録の有無（真偽値）だけを描画し、キーの値は入力欄にも出さない
// （SecretInput は value 属性を持たない。失敗の再描画でも入力は空に戻る）。登録は PUT、削除は確認モーダルを経る。
templ APIKeyPanel(p view.APIKeyPanel) {
	<div id={ p.ID } class="space-y-3" data-api-key={ p.Provider } data-key-state={ keyState(p.Registered) }>
		<div class="flex flex-wrap items-center gap-2">
			<span class="text-sm font-medium text-slate-700">{ p.Provider } API キー</span>
			if p.Registered {
				@atoms.Badge(atoms.BadgeOK, "登録済み")
			} else {
				@atoms.Badge(atoms.BadgeWarn, "未登録")
			}
		</div>
		<form
			class="space-y-2"
			novalidate
			autocomplete="off"
			hx-put={ p.PutURL }
			hx-target={ "#" + p.ID }
			hx-swap="outerHTML"
			hx-target-422={ "#" + p.ID }
			hx-disabled-elt="find button[type=submit]"
		>
			@molecules.FormField(p.ID+"-input", keyInputLabel(p.Registered), "", p.Error) {
				@atoms.SecretInput(p.ID+"-input", "api_key", p.Error != "")
			}
			<p class="text-xs text-slate-500" data-notice="key-storage">
				キーは Windows の資格情報マネージャー（{ p.Target }）にだけ保存します。登録後は、この画面にも、ログ・監査ログにも表示しません（もう一度見ることはできません）。
			</p>
			<div class="flex flex-wrap items-center gap-2">
				@atoms.Button(atoms.ButtonProps{Label: keyButtonLabel(p.Registered), Variant: atoms.ButtonPrimary, Type: "submit"})
				if p.Registered {
					@atoms.Button(atoms.ButtonProps{Label: "削除", Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
						"hx-get": p.ConfirmURL, "hx-target": "#modal-root", "hx-swap": "innerHTML", "data-key-delete": p.Provider,
					}})
				}
			</div>
		</form>
	</div>
}

func keyState(registered bool) string {
	if registered {
		return "registered"
	}
	return "unregistered"
}

func keyInputLabel(registered bool) string {
	if registered {
		return "新しい API キー（入力すると置き換えます）"
	}
	return "API キー"
}

func keyButtonLabel(registered bool) string {
	if registered {
		return "置き換える"
	}
	return "登録"
}

// AgentForm はエージェント（OpenAI）の設定フォーム（FR-H11、FR-G14、FR-S10〜S13、FR-S19）。
// 有効化には OpenAI へのスクリーンショット送信への同意が要る。検証エラーは 422 で、入力値とメッセージ付きで再描画する。
templ AgentForm(f view.AgentForm) {
	<form
		id="agent-form"
		class="space-y-4"
		novalidate
		hx-put="/agent"
		hx-target="this"
		hx-swap="outerHTML"
		hx-target-422="this"
		hx-disabled-elt="find button[type=submit]"
		hx-indicator="#agent-spinner"
	>
		if f.Errors.General != "" {
			<p class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-800" role="alert" data-form-error="agent">{ f.Errors.General }</p>
		}
		<label class="flex items-center gap-2 text-sm font-medium text-slate-800">
			@atoms.Checkbox("agent-enabled", "enabled", f.Values.Enabled)
			エージェントを有効にする
		</label>
		<p class="text-xs text-slate-500">既定は無効です。有効にするには、OpenAI API キーの登録と、下の同意が必要です。</p>
		<div class="space-y-1 rounded-md border border-amber-300 bg-amber-50 px-3 py-2" data-consent="openai">
			<label class="flex items-start gap-2 text-sm text-amber-950">
				@atoms.Checkbox("agent-consent", "consent", f.Values.Consent)
				<span>エージェントが操作するたびに、画面のスクリーンショット（縮小したプライマリモニターの全体。画面に映るものはすべて含まれます）と指示・操作の履歴が <strong>OpenAI に送信される</strong>ことに同意します。</span>
			</label>
			<p class="text-xs text-amber-900">API のデータは、OpenAI の文書では既定でモデルの学習に使われません（常に store: false で送ります）。不正利用の監視のためのログは最大 30 日保持されることがあります。</p>
			if f.ConsentAt != "" {
				<p class="text-xs text-amber-900" data-consent-at="openai">同意済み: { f.ConsentAt }</p>
			}
			if f.Errors.Consent != "" {
				<p class="text-xs text-red-700" role="alert" data-field-error="agent-consent">{ f.Errors.Consent }</p>
			}
		</div>
		@molecules.FormField("agent-model", "モデル", "OpenAI のモデル名。既定は gpt-6.1-sol。", f.Errors.Model) {
			@atoms.Input(atoms.InputProps{ID: "agent-model", Name: "model", Value: f.Values.Model, Required: true, Invalid: f.Errors.Model != "", Attrs: atoms.Attrs{"autocomplete": "off"}})
		}
		@molecules.FormField("agent-max-steps", "ステップ数の上限", "1〜500。既定は 50。超えるとタスクを中止します。", f.Errors.MaxSteps) {
			@atoms.Input(atoms.InputProps{ID: "agent-max-steps", Name: "max_steps", Type: "number", Value: f.Values.MaxSteps, Required: true, Invalid: f.Errors.MaxSteps != "", Attrs: numberAttrs("1", "500")})
		}
		@molecules.FormField("agent-max-duration", "実行時間の上限（秒）", "30〜7200。既定は 600。", f.Errors.MaxDurationSec) {
			@atoms.Input(atoms.InputProps{ID: "agent-max-duration", Name: "max_duration_sec", Type: "number", Value: f.Values.MaxDurationSec, Required: true, Invalid: f.Errors.MaxDurationSec != "", Attrs: numberAttrs("30", "7200")})
		}
		@molecules.FormField("agent-keep-screenshots", "OpenAI へ送るスクリーンショットの保持枚数", "1〜10。既定は 3。これより古い画像は文字のプレースホルダーに置き換えて送ります。", f.Errors.KeepScreenshots) {
			@atoms.Input(atoms.InputProps{ID: "agent-keep-screenshots", Name: "keep_screenshots", Type: "number", Value: f.Values.KeepScreenshots, Required: true, Invalid: f.Errors.KeepScreenshots != "", Attrs: numberAttrs("1", "10")})
		}
		@molecules.FormField("agent-deny", "拒否するプロセス（1 行に 1 つ）", "これらが前面のウィンドウのとき、エージェントの入力をブロックします。画面のキャプチャは隠しません。", f.Errors.DenyProcesses) {
			@atoms.Textarea(atoms.TextareaProps{ID: "agent-deny", Name: "deny_processes", Value: f.Values.DenyProcesses, Rows: 4, Invalid: f.Errors.DenyProcesses != "", Attrs: atoms.Attrs{"spellcheck": "false"}})
		}
		@molecules.FormField("agent-approve", "毎回承認するプロセス（1 行に 1 つ）", "これらが前面のウィンドウのとき、操作ごとにホストの承認を求めます。", f.Errors.ApproveProcesses) {
			@atoms.Textarea(atoms.TextareaProps{ID: "agent-approve", Name: "approve_processes", Value: f.Values.ApproveProcesses, Rows: 3, Invalid: f.Errors.ApproveProcesses != "", Attrs: atoms.Attrs{"spellcheck": "false"}})
		}
		<div class="flex items-center gap-3">
			@atoms.Button(atoms.ButtonProps{Label: "保存", Variant: atoms.ButtonPrimary, Type: "submit"})
			@atoms.Spinner("agent-spinner")
		</div>
	</form>
}

// FastpathForm は高速パス（TypeSafe の Jev）の設定フォーム（FR-H11、FR-G22、FR-S14〜S18）。
// エージェントの有効化・同意とは独立で、TypeSafe への送信内容（NFR-PR04）に対する別の同意が要る。
templ FastpathForm(f view.FastpathForm) {
	<form
		id="fastpath-form"
		class="space-y-4"
		novalidate
		hx-put="/agent/fastpath"
		hx-target="this"
		hx-swap="outerHTML"
		hx-target-422="this"
		hx-disabled-elt="find button[type=submit]"
		hx-indicator="#fastpath-spinner"
	>
		if f.Errors.General != "" {
			<p class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-800" role="alert" data-form-error="fastpath">{ f.Errors.General }</p>
		}
		<label class="flex items-center gap-2 text-sm font-medium text-slate-800">
			@atoms.Checkbox("fastpath-enabled", "enabled", f.Values.Enabled)
			高速パスを有効にする
		</label>
		<p class="text-xs text-slate-500">既定は無効です。有効にするには、TypeSafe API キーの登録と、下の別の同意が必要です（エージェントの有効・無効とは独立）。確信が持てないときは、OpenAI の通常のループへ引き継ぎます。</p>
		<div class="space-y-1 rounded-md border border-amber-300 bg-amber-50 px-3 py-2" data-consent="typesafe">
			<label class="flex items-start gap-2 text-sm text-amber-950">
				@atoms.Checkbox("fastpath-consent", "consent", f.Values.Consent)
				<span>タスクの指示、前面のウィンドウのタイトルとプロセス名、操作できる要素の ID・役割・ラベル・有効かどうか、直近 5 件の高速ステップの短い説明文が <strong>TypeSafe（api.typesafe.ai）に送信される</strong>ことに同意します。</span>
			</label>
			<p class="text-xs text-amber-900">スクリーンショット、要素の値・テキスト内容、入力した文字（type の本文）、キー入力、API キーは送信しません。ウィンドウのタイトルには、文書名や URL などの機微な情報が含まれることがあります。</p>
			if f.ConsentAt != "" {
				<p class="text-xs text-amber-900" data-consent-at="typesafe">同意済み: { f.ConsentAt }</p>
			}
			if f.Errors.Consent != "" {
				<p class="text-xs text-red-700" role="alert" data-field-error="fastpath-consent">{ f.Errors.Consent }</p>
			}
		</div>
		@molecules.FormField("fastpath-model", "モデル", "TypeSafe のモデル名。既定は jev-1.13。", f.Errors.Model) {
			@atoms.Input(atoms.InputProps{ID: "fastpath-model", Name: "model", Value: f.Values.Model, Required: true, Invalid: f.Errors.Model != "", Attrs: atoms.Attrs{"autocomplete": "off"}})
		}
		@molecules.FormField("fastpath-min-confidence", "確信度のしきい値", "0〜1。既定は 0.7。これを下回る回答は受け入れず、OpenAI へ引き継ぎます。", f.Errors.MinConfidence) {
			@atoms.Input(atoms.InputProps{ID: "fastpath-min-confidence", Name: "min_confidence", Type: "number", Value: f.Values.MinConfidence, Required: true, Invalid: f.Errors.MinConfidence != "", Attrs: atoms.Attrs{"min": "0", "max": "1", "step": "0.05", "inputmode": "decimal"}})
		}
		@molecules.FormField("fastpath-max-steps", "高速ステップ数の上限", "1〜500。既定は 15。到達すると OpenAI へ引き継ぎます。", f.Errors.MaxSteps) {
			@atoms.Input(atoms.InputProps{ID: "fastpath-max-steps", Name: "max_steps", Type: "number", Value: f.Values.MaxSteps, Required: true, Invalid: f.Errors.MaxSteps != "", Attrs: numberAttrs("1", "500")})
		}
		@molecules.FormField("fastpath-excluded", "除外するラベル（1 行に 1 つ）", "ラベルにこれを含む要素は候補から外します（大文字小文字を区別しない部分一致）。", f.Errors.ExcludedLabels) {
			@atoms.Textarea(atoms.TextareaProps{ID: "fastpath-excluded", Name: "excluded_labels", Value: f.Values.ExcludedLabels, Rows: 5, Invalid: f.Errors.ExcludedLabels != "", Attrs: atoms.Attrs{"spellcheck": "false"}})
		}
		<div class="flex items-center gap-3">
			@atoms.Button(atoms.ButtonProps{Label: "保存", Variant: atoms.ButtonPrimary, Type: "submit"})
			@atoms.Spinner("fastpath-spinner")
		</div>
	</form>
}

// AgentSections はエージェント設定の本体（#agent-sections）。OpenAI のキーと設定、高速パスのキーと設定の 4 つ。
// API キーの削除は、エージェント・高速パスの設定にも及ぶため、確定の応答はこの全体を差し替える。
templ AgentSections(v view.AgentSettings) {
	<div id="agent-sections" class="space-y-6">
		@molecules.Card("OpenAI エージェント") {
			<div class="space-y-5">
				@APIKeyPanel(v.AgentKey)
				<div class="border-t border-slate-200 pt-4">
					@AgentForm(v.Agent)
				</div>
			</div>
		}
		@molecules.Card("高速パス（TypeSafe）") {
			<div class="space-y-5">
				@APIKeyPanel(v.FastpathKey)
				<div class="border-t border-slate-200 pt-4">
					@FastpathForm(v.Fastpath)
				</div>
			</div>
		}
	</div>
}
