package organisms

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func expiryOptions(opts []view.ExpiryOption) []atoms.SelectOption {
	out := make([]atoms.SelectOption, len(opts))
	for i, o := range opts {
		out[i] = atoms.SelectOption{Value: o.Value, Label: o.Label, Selected: o.Selected}
	}
	return out
}

// TokenFieldError はトークン発行フォームのエラー（422 / 409 の表示先 #token-form-errors の中身）。
templ TokenFieldError(msg, code string) {
	@atoms.NoticeAnimated(atoms.AlertDanger, atoms.Attrs{"role": "alert", "data-error-code": code}) {
		{ msg }
	}
}

func tokenFormAttrs(oob bool) atoms.Attrs {
	if oob {
		return atoms.Attrs{"hx-swap-oob": "true"}
	}
	return nil
}

// TokenForm はトークン発行フォーム（FR-A08）。発行の応答は #token-result へ、エラーは #token-form-errors へ出す。
// oob = true は、発行の成功の応答に添えて、フォームを空の状態に戻すとき（古いエラーとラベルを残さない）。
templ TokenForm(f view.TokenForm, oob bool) {
	<form
		id="token-form"
		novalidate
		{ tokenFormAttrs(oob)... }
		class="grid gap-4 sm:grid-cols-[1fr_12rem_auto] sm:items-end"
		hx-post={ f.ActionURL }
		hx-target="#token-result"
		hx-swap="innerHTML"
		hx-target-4xx="#token-form-errors"
		hx-disabled-elt="find button"
		hx-indicator="#token-spinner"
	>
		@molecules.FormField("token-label", "ラベル（用途）", "例: claude-desktop", "") {
			@atoms.Input(atoms.InputProps{ID: "token-label", Name: "label", Value: f.Label, Required: true, Attrs: atoms.Attrs{"maxlength": "64", "autocomplete": "off"}})
		}
		@molecules.FormField("token-expiry", "有効期限", "", "") {
			@atoms.Select("token-expiry", "expires_in_days", expiryOptions(f.Expiry))
		}
		<div class="flex items-center gap-2">
			@atoms.Button(atoms.ButtonProps{Label: "トークンを発行", Variant: atoms.ButtonPrimary, Type: "submit"})
			@atoms.Spinner("token-spinner")
		</div>
		<div id="token-form-errors" class="sm:col-span-3" aria-live="polite">
			if f.Error != "" {
				@TokenFieldError(f.Error, "invalid_argument")
			}
		</div>
	</form>
}
