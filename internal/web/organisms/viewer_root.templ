package organisms

import (
	"github.com/ousiassllc/puppet-remo/internal/web/view"
	"strconv"
)

// ViewerRoot はビューアの本体（<main id="viewer-root">。frontend.md §5.1・§6.2）。ページルートの HX-Request の応答もこれ。
// hx-headers の X-Viewer-Id は子孫へ継承され、ツールバー・リース・クリップボード・ショートカットのリクエストに付く。
// 確認モーダルの置き場（#modal-root）もここに置く（強制剥奪の確定のリクエストにも X-Viewer-Id を付けるため）。
// ページの h1 は見せない（visually-hidden。画面は映像が主）。<remo-screen-viewer> は HTMX が差し替えない領域に置き（Lit の描画を壊さない）、readonly は描画時の操作権の有無から決める。
// ツールバー・題付きの Card（操作権・操作するウィンドウ・クリップボード・ショートカット）・映像は、どれも部品なので 24（--gap-grid-lg。
// space-y-6 / gap-6）で並べる。Card は 1 つの枠（flex-col gap-6）にまとめる。htmx が差し替える枠・空の #viewer-ops・隠しの trigger がある並びは、
// space-y ではなく gap で間隔を作る（描画しない要素の分の隙間が入らない）。
templ ViewerRoot(v view.Viewer) {
	<main id="viewer-root" class="space-y-6" hx-headers={ templ.JSONString(map[string]string{"X-Viewer-Id": v.ViewerID}) }>
		<h1 class="sr-only">ビューア</h1>
		@ViewerToolbar(v.Toolbar)
		<div class="flex flex-col gap-6" data-viewer-sections>
			@ViewerLeasePanel(v.Lease)
			@WindowPicker(v.Picker)
			@WindowReselectTrigger()
			@ViewerOps(v.Ops)
		</div>
		<remo-screen-viewer
			class="block overflow-hidden rounded-card card-edge bg-bone"
			ws-url={ v.WSURL }
			readonly?={ !v.Lease.Mine }
			monitor={ strconv.Itoa(v.Monitor) }
			quality={ strconv.Itoa(v.Quality) }
			fps={ strconv.Itoa(v.FPS) }
		></remo-screen-viewer>
		@ModalRoot()
	</main>
}
