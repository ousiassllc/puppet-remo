package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func tone(t view.BadgeTone) atoms.BadgeTone { return atoms.BadgeTone(t) }

// ServerStatusBody はサーバー状態の中身（SSE の server-status イベントの data）。
templ ServerStatusBody(v view.ServerStatus) {
	<dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-2 text-sm">
		<dt class="text-slate-500">tailscaled</dt>
		<dd>@atoms.Badge(tone(v.TailscaledTone), v.TailscaledLabel)</dd>
		<dt class="text-slate-500">tailnet IP</dt>
		<dd data-field="tailnet-ips">
			if len(v.TailnetIPs) == 0 {
				<span class="text-slate-500">未取得</span>
			}
			for _, ip := range v.TailnetIPs {
				<code class="mr-2 rounded bg-slate-100 px-1.5 py-0.5 text-xs">{ ip }</code>
			}
		</dd>
		if v.DNSName != "" {
			<dt class="text-slate-500">MagicDNS 名</dt>
			<dd><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{ v.DNSName }</code></dd>
		}
		<dt class="text-slate-500">ポート</dt>
		<dd data-field="port">{ strconv.Itoa(v.Port) }</dd>
		<dt class="text-slate-500">待ち受け</dt>
		<dd>
			@atoms.Badge(tone(v.ListenTone), v.ListenLabel)
			for _, a := range v.ListenAddrs {
				<code class="ml-2 rounded bg-slate-100 px-1.5 py-0.5 text-xs">{ a }</code>
			}
		</dd>
	</dl>
	if v.Reason != "" {
		<p class="mt-3 rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-800" role="status">{ v.Reason }</p>
	}
}

// ServerStatusPanel はダッシュボードのサーバー状態（FR-H02）。
templ ServerStatusPanel(v view.ServerStatus) {
	@molecules.Card("サーバー状態") {
		<div id="server-status" sse-swap="server-status" hx-target="this" hx-swap="innerHTML">
			@ServerStatusBody(v)
		</div>
	}
}

// SessionListBody は接続中セッション一覧の中身（SSE の sessions イベントの data）。
templ SessionListBody(v view.Sessions) {
	if len(v.Items) == 0 {
		<p class="text-sm text-slate-500">接続中のセッションはありません。</p>
	} else {
		<ul class="divide-y divide-slate-100 text-sm">
			for _, s := range v.Items {
				<li class="flex items-center justify-between py-2" data-session>
					<span class="font-medium text-slate-800">{ s.ClientLabel }</span>
					<span class="flex items-center gap-2">
						@atoms.Badge(atoms.BadgeNeutral, s.KindLabel)
						<span class="text-xs text-slate-500">{ s.Since } から</span>
					</span>
				</li>
			}
		</ul>
	}
}

// SessionList は接続中セッションの一覧。
templ SessionList(v view.Sessions) {
	@molecules.Card("接続中のセッション") {
		<div id="sessions" sse-swap="sessions" hx-target="this" hx-swap="innerHTML">
			@SessionListBody(v)
		</div>
	}
}

// LeasePanelBody はリース保持者の中身（SSE の lease イベントの data）。M1 は表示のみで、強制剥奪の操作は描画しない。
templ LeasePanelBody(v view.Lease) {
	@molecules.LeaseBadge(v.Held, v.HolderLabel, v.KindLabel)
	if v.Held {
		<p class="mt-2 text-xs text-slate-500">{ v.Since } から ・ アイドル解放まで { v.IdleRemaining }</p>
	}
}

// LeasePanel はリース保持者（種別付き）。
templ LeasePanel(v view.Lease) {
	@molecules.Card("操作権（リース）") {
		<div id="lease" sse-swap="lease" hx-target="this" hx-swap="innerHTML">
			@LeasePanelBody(v)
		</div>
	}
}

// KillSwitchPanel はキルスイッチ。発動中は解除のボタンだけ、そうでなければ発動のボタンだけを描画する（状態駆動）。
// 発動の応答・SSE の killswitch イベントで再取得する（GET /killswitch）。
templ KillSwitchPanel(v view.KillSwitch) {
	<section
		id="killswitch-panel"
		class="rounded-lg border border-slate-200 bg-white shadow-sm"
		hx-get="/killswitch"
		hx-trigger="sse:killswitch"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<h2 class="border-b border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700">キルスイッチ</h2>
		<div class="space-y-3 p-4">
			if v.Active {
				<p class="text-sm text-red-700" data-killswitch="active">
					発動中です。すべての操作権を剥奪し、リモートからの要求を断っています。
				</p>
				if v.Since != "" {
					<p class="text-xs text-slate-500">{ v.Since } に発動（{ v.Source }）</p>
				}
			} else {
				<p class="text-sm text-slate-600" data-killswitch="inactive">
					緊急時に、すべての操作権を剥奪し、リモートからの要求を断ちます。
				</p>
			}
			if v.CanTrigger {
				@atoms.Button(atoms.ButtonProps{Label: "キルスイッチを発動", Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
					"hx-post": "/killswitch/trigger", "hx-target": "#killswitch-panel", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
				}})
			}
			if v.CanRelease {
				@atoms.Button(atoms.ButtonProps{Label: "キルスイッチを解除", Variant: atoms.ButtonPrimary, Attrs: atoms.Attrs{
					"hx-get": v.ConfirmRoute, "hx-target": "#modal-root", "hx-swap": "innerHTML",
				}})
			}
		</div>
	</section>
}
