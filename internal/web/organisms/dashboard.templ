package organisms

import (
	"strconv"

	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/molecules"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func tone(t view.BadgeTone) atoms.BadgeTone { return atoms.BadgeTone(t) }

// ServerStatusBody はサーバー状態の中身（SSE の server-status イベントの data と、GET /poll の OOB の中身）。
templ ServerStatusBody(v view.ServerStatus) {
	<dl class="grid grid-cols-1 gap-x-4 gap-y-1 text-sm sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-y-2">
		<dt class="text-mute">tailscaled</dt>
		<dd class="mb-1 min-w-0 sm:mb-0">@atoms.Badge(tone(v.TailscaledTone), v.TailscaledLabel)
</dd>
		<dt class="text-mute">tailnet IP</dt>
		<dd data-field="tailnet-ips" class="mb-1 flex min-w-0 flex-wrap gap-2 sm:mb-0">
			if len(v.TailnetIPs) == 0 {
				<span class="text-mute">未取得</span>
			}
			for _, ip := range v.TailnetIPs {
				<code class="max-w-full break-all rounded-sm bg-accent-soft px-2 py-1 text-xs">{ ip }</code>
			}
		</dd>
		if v.DNSName != "" {
			<dt class="text-mute">MagicDNS 名</dt>
			<dd class="mb-1 min-w-0 sm:mb-0"><code class="break-all rounded-sm bg-accent-soft px-2 py-1 text-xs">{ v.DNSName }</code></dd>
		}
		<dt class="text-mute">ポート</dt>
		<dd data-field="port" class="mb-1 min-w-0 sm:mb-0">{ strconv.Itoa(v.Port) }</dd>
		<dt class="text-mute">待ち受け</dt>
		<dd class="flex min-w-0 flex-wrap items-center gap-2">
			@atoms.Badge(tone(v.ListenTone), v.ListenLabel)
			for _, a := range v.ListenAddrs {
				<code class="max-w-full break-all rounded-sm bg-accent-soft px-2 py-1 text-xs">{ a }</code>
			}
		</dd>
	</dl>
	if v.Reason != "" {
		<div class="mt-3">
			@atoms.Notice(atoms.AlertWarning, atoms.Attrs{"role": "status"}) {
				{ v.Reason }
			}
		</div>
	}
}

// ServerStatusPanel はダッシュボードのサーバー状態（FR-H02）。
templ ServerStatusPanel(v view.ServerStatus) {
	@molecules.Card("サーバー状態") {
		<div id="server-status">
			@ServerStatusBody(v)
		</div>
	}
}

// SessionListBody は接続中セッション一覧の中身（SSE の sessions イベントの data と、GET /poll の OOB の中身）。
templ SessionListBody(v view.Sessions) {
	if len(v.Items) == 0 {
		@molecules.EmptyState("sessions") {
			接続中のセッションはありません。
		}
	} else {
		<ul class="divide-y divide-border text-sm">
			for _, s := range v.Items {
				<li class="flex items-center justify-between py-2" data-session>
					<span class="text-ink">{ s.ClientLabel }</span>
					<span class="flex items-center gap-2">
						@atoms.Badge(atoms.BadgeNeutral, s.KindLabel)
						<span class="text-xs text-mute">{ s.Since } から</span>
					</span>
				</li>
			}
		</ul>
	}
}

// SessionList は接続中セッションの一覧。
templ SessionList(v view.Sessions) {
	@molecules.Card("接続中のセッション") {
		<div id="sessions">
			@SessionListBody(v)
		</div>
	}
}

// LeaseDisplay はリース保持者の表示だけ（操作は無い）。SSE の lease イベントの data（`/events` は M2 でも変えない）。
templ LeaseDisplay(v view.Lease) {
	if v.Pending {
		@molecules.LeasePendingBadge(v.HolderLabel, v.KindLabel)
		<p class="mt-2 text-sm text-ink">{ v.Since } から ・ ホストの承認を待っています（承認ダイアログで許可・拒否します）</p>
	} else {
		@molecules.LeaseBadge(v.Held, v.HolderLabel, v.KindLabel)
	}
	if v.Held {
		<p class="mt-2 text-xs text-mute">{ v.Since } から ・ アイドル解放まで { v.IdleRemaining }</p>
	}
}

// LeasePanelBody はリース保持者の中身（GET /poll の OOB の中身と、POST /lease/revoke の応答）。
// 強制剥奪のボタンは、剥奪できる保持者（他者。mcp・web・agent）がいるときだけ描画する（状態駆動。FR-H02、FR-L06、FR-L08）。
// agent の剥奪はそのタスクを中断するので、その旨（RevokeHint）をボタンの下に添える。
templ LeasePanelBody(v view.Lease) {
	@LeaseDisplay(v)
	if v.CanRevoke {
		<div class="mt-3">
			@atoms.Button(atoms.ButtonProps{Label: "強制剥奪", Small: true, Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
				"hx-get": "/lease/revoke/confirm", "hx-target": "#modal-root", "hx-swap": "innerHTML",
			}})
			if v.RevokeHint != "" {
				<div class="mt-2">
					@atoms.Notice(atoms.AlertWarning, atoms.Attrs{"data-revoke-hint": true}) {
						{ v.RevokeHint }
					}
				</div>
			}
		</div>
	}
}

// LeasePanel はリース保持者（種別付き）。
templ LeasePanel(v view.Lease) {
	@molecules.Card("操作権（リース）") {
		<div id="lease">
			@LeasePanelBody(v)
		</div>
	}
}

// ServerStatusOOB は GET /poll の応答に添えて、#server-status の中身を更新する（OOB）。
templ ServerStatusOOB(v view.ServerStatus) {
	<div id="server-status" hx-swap-oob="innerHTML">
		@ServerStatusBody(v)
	</div>
}

// SessionListOOB は GET /poll の応答に添えて、#sessions の中身を更新する（OOB）。
templ SessionListOOB(v view.Sessions) {
	<div id="sessions" hx-swap-oob="innerHTML">
		@SessionListBody(v)
	</div>
}

// LeasePanelOOB は GET /poll の応答に添えて、#lease の中身を更新する（OOB）。
templ LeasePanelOOB(v view.Lease) {
	<div id="lease" hx-swap-oob="innerHTML">
		@LeasePanelBody(v)
	</div>
}

// KillSwitchPanel はキルスイッチ。発動中は解除のボタンだけ、そうでなければ発動のボタンだけを描画する（状態駆動）。
// 発動・解除の応答（差し替え）と GET /poll の応答（KillSwitchPanelOOB）で更新する。
templ KillSwitchPanel(v view.KillSwitch) {
	@killSwitchPanel(v, false)
}

// KillSwitchPanelOOB は GET /poll の応答に添えて、キルスイッチのパネルを差し替える（OOB）。
templ KillSwitchPanelOOB(v view.KillSwitch) {
	@killSwitchPanel(v, true)
}

// killSwitchPanel の隠し入力（data-poll-rev）は、描画した状態の版。ポーリングが送り返し、変わっていなければサーバーは差し替えない。
templ killSwitchPanel(v view.KillSwitch, oob bool) {
	<section
		id="killswitch-panel"
		class="rounded-lg border border-border bg-surface"
		{ oobAttrs(oob)... }
	>
		<input type="hidden" name="rev_killswitch" value={ v.Rev } data-poll-rev/>
		<h2 class="border-b border-border px-6 py-3 text-base font-semibold text-ink">キルスイッチ</h2>
		<div class="space-y-3 p-6">
			if v.Active {
				@atoms.NoticeAnimated(atoms.AlertDanger, atoms.Attrs{"role": "status", "data-killswitch": "active"}) {
					発動中です。すべての操作権を剥奪し、リモートからの要求を断っています。
				}
				if v.Since != "" {
					<p class="text-xs text-mute">{ v.Since } に発動（{ v.Source }）</p>
				}
			} else {
				<p class="text-base text-ink" data-killswitch="inactive">
					緊急時に、すべての操作権を剥奪し、リモートからの要求を断ちます。
				</p>
			}
			if v.CanTrigger {
				@atoms.Button(atoms.ButtonProps{Label: "キルスイッチを発動", Variant: atoms.ButtonDanger, Attrs: atoms.Attrs{
					"hx-post": "/killswitch/trigger", "hx-target": "#killswitch-panel", "hx-swap": "outerHTML", "hx-disabled-elt": "this",
				}})
			}
			if v.CanRelease {
				@atoms.Button(atoms.ButtonProps{Label: "キルスイッチを解除", Variant: atoms.ButtonPrimary, Attrs: atoms.Attrs{
					"hx-get": v.ConfirmRoute, "hx-target": "#modal-root", "hx-swap": "innerHTML",
				}})
			}
		</div>
	</section>
}
