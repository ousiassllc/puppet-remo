package molecules

// Card は見出し付きの枠。
templ Card(title string) {
	<section class="rounded-lg border border-border bg-surface shadow-sm">
		if title != "" {
			<h2 class="border-b border-border px-4 py-2.5 text-base font-semibold text-ink">{ title }</h2>
		}
		<div class="p-4">
			{ children... }
		</div>
	</section>
}
