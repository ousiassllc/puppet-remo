package molecules

// Card は見出し付きの枠。
templ Card(title string) {
	<section class="rounded-lg border border-border bg-surface">
		if title != "" {
			<h2 class="border-b border-border px-6 py-3 text-2xl font-semibold text-ink">{ title }</h2>
		}
		<div class="p-6">
			{ children... }
		</div>
	</section>
}
