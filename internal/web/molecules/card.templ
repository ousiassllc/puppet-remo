package molecules

// Card は見出し付きの枠。
templ Card(title string) {
	<section class="rounded-lg border border-slate-200 bg-white shadow-sm">
		if title != "" {
			<h2 class="border-b border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700">{ title }</h2>
		}
		<div class="p-4">
			{ children... }
		</div>
	</section>
}
