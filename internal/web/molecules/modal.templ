package molecules

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func confirmAttrs(m view.ConfirmModal) atoms.Attrs {
	a := atoms.Attrs{"hx-target": m.Target, "hx-swap": m.Swap, "hx-disabled-elt": "this"}
	switch m.Method {
	case "delete":
		a["hx-delete"] = m.ConfirmURL
	default:
		a["hx-post"] = m.ConfirmURL
	}
	return a
}

// confirmVariant は確定ボタンの種類。破壊的な操作だけ危険（--danger）で、キルスイッチの解除・更新の適用のような破壊的でない確認は主（O7）。
func confirmVariant(m view.ConfirmModal) atoms.ButtonVariant {
	if m.Destructive {
		return atoms.ButtonDanger
	}
	return atoms.ButtonPrimary
}

// Modal は確認ダイアログ（O2）。サーバーが描画し、確定のボタンだけが実際の操作を送る（§5.4）。
// 確認用の GET が #modal-root に差し込み、キャンセルは app.ts が data-clear の対象（#modal-root）を空にする。
// 確定の応答は OOB で #modal-root を空にする（organisms.ModalClear）。
templ Modal(m view.ConfirmModal) {
	<div id="modal" class="motion-modal-in fixed inset-0 z-(--z-modal) flex items-center justify-center bg-scrim p-4 md:p-6" role="dialog" aria-modal="true" aria-labelledby="modal-title">
		<div class="motion-modal-rise-in w-full max-w-md rounded-xl border border-border bg-surface p-6 shadow-modal">
			<h2 id="modal-title" class="text-lg font-semibold text-ink">{ m.Title }</h2>
			<p class="mt-2 text-base text-ink">{ m.Message }</p>
			<div class="mt-6 flex justify-end gap-2">
				@atoms.Button(atoms.ButtonProps{Label: "キャンセル", Variant: atoms.ButtonGhost, Attrs: atoms.Attrs{"data-clear": "#modal-root"}})
				@atoms.Button(atoms.ButtonProps{Label: m.Label, Variant: confirmVariant(m), Attrs: confirmAttrs(m)})
			</div>
		</div>
	</div>
}
