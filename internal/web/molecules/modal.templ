package molecules

import (
	"github.com/ousiassllc/puppet-remo/internal/web/atoms"
	"github.com/ousiassllc/puppet-remo/internal/web/view"
)

func confirmAttrs(m view.ConfirmModal) atoms.Attrs {
	a := atoms.Attrs{"hx-target": m.Target, "hx-swap": m.Swap, "hx-disabled-elt": "this"}
	switch m.Method {
	case "delete":
		a["hx-delete"] = m.ConfirmURL
	default:
		a["hx-post"] = m.ConfirmURL
	}
	return a
}

// Modal は破壊的な操作の確認ダイアログ。サーバーが描画し、確定のボタンだけが実際の操作を送る（§5.4）。
// 確認用の GET が #modal-root に差し込み、キャンセルは app.ts が data-clear の対象（#modal-root）を空にする。
// 確定の応答は OOB で #modal-root を空にする（organisms.ModalClear）。
templ Modal(m view.ConfirmModal) {
	<div id="modal" class="motion-fade-in fixed inset-0 z-40 flex items-center justify-center bg-scrim" role="dialog" aria-modal="true" aria-labelledby="modal-title">
		<div class="motion-rise-in w-full max-w-md rounded-xl border border-border bg-surface p-6 shadow-modal">
			<h2 id="modal-title" class="text-base font-semibold text-ink">{ m.Title }</h2>
			<p class="mt-2 text-base text-ink">{ m.Message }</p>
			<div class="mt-6 flex justify-end gap-2">
				@atoms.Button(atoms.ButtonProps{Label: "キャンセル", Variant: atoms.ButtonSecondary, Attrs: atoms.Attrs{"data-clear": "#modal-root"}})
				@atoms.Button(atoms.ButtonProps{Label: m.Label, Variant: atoms.ButtonDanger, Attrs: confirmAttrs(m)})
			</div>
		</div>
	</div>
}
