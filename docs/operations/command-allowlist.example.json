{
  "version": 1,
  "commands": [
    {
      "name": "app-version",
      "description": "Print the version of the app under test (the app's own --version).",
      "executable": "C:\\Program Files\\MyApp\\MyApp.exe",
      "args": ["--version"],
      "timeout_sec": 10,
      "enabled": false
    },
    {
      "name": "file-version",
      "description": "Print the file version of one of the listed files.",
      "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoProfile", "-NonInteractive", "-Command", "(Get-Item -LiteralPath '{target}').VersionInfo.FileVersion"],
      "params": {
        "target": {
          "type": "enum",
          "values": ["C:\\Program Files\\MyApp\\MyApp.exe", "C:\\Program Files\\MyApp\\MyApp.dll"]
        }
      },
      "timeout_sec": 20,
      "enabled": false
    },
    {
      "name": "file-exists",
      "description": "Exit code 0 if one of the listed paths exists, 1 if not.",
      "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoProfile", "-NonInteractive", "-Command", "if (Test-Path -LiteralPath '{target}') {{ exit 0 }} else {{ exit 1 }}"],
      "params": {
        "target": {
          "type": "enum",
          "values": ["C:\\Program Files\\MyApp\\MyApp.exe", "C:\\ProgramData\\MyApp\\config.json"]
        }
      },
      "timeout_sec": 20,
      "enabled": false
    },
    {
      "name": "process-list",
      "description": "List all processes (CSV, no header).",
      "executable": "C:\\Windows\\System32\\tasklist.exe",
      "args": ["/fo", "csv", "/nh"],
      "timeout_sec": 30,
      "max_output_bytes": 262144,
      "enabled": false
    },
    {
      "name": "process-find",
      "description": "List the processes with the given image name (for example MyApp.exe).",
      "executable": "C:\\Windows\\System32\\tasklist.exe",
      "args": ["/fi", "IMAGENAME eq {image}", "/fo", "csv", "/nh"],
      "params": {
        "image": { "type": "string", "pattern": "[A-Za-z0-9._-]{1,64}", "max_length": 64 }
      },
      "timeout_sec": 30,
      "enabled": false
    },
    {
      "name": "listening-ports",
      "description": "Show the connections and listening ports with their process ids.",
      "executable": "C:\\Windows\\System32\\netstat.exe",
      "args": ["-ano"],
      "timeout_sec": 30,
      "max_output_bytes": 262144,
      "enabled": false
    },
    {
      "name": "http-check",
      "description": "Print the HTTP status code of http://<host>:<port>/ (000 when it cannot connect).",
      "executable": "C:\\Windows\\System32\\curl.exe",
      "args": ["--silent", "--max-time", "5", "--output", "NUL", "--write-out", "%{{http_code}}", "http://{host}:{port}/"],
      "params": {
        "host": { "type": "string", "pattern": "[A-Za-z0-9.-]{1,253}", "max_length": 253 },
        "port": { "type": "int", "min": 1, "max": 65535 }
      },
      "timeout_sec": 10,
      "enabled": false
    },
    {
      "name": "ping-host",
      "description": "Ping a host name or IPv4 address twice.",
      "executable": "C:\\Windows\\System32\\PING.EXE",
      "args": ["-n", "2", "{host}"],
      "params": {
        "host": { "type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9.-]{0,252}", "max_length": 253 }
      },
      "timeout_sec": 15,
      "enabled": false
    },
    {
      "name": "install-msi",
      "description": "Install an .msi that was put in the transfer folder, silently.",
      "executable": "C:\\Windows\\System32\\msiexec.exe",
      "args": ["/i", "{file}", "/qn", "/norestart"],
      "params": {
        "file": { "type": "inbox_path", "extensions": [".msi"] }
      },
      "timeout_sec": 600,
      "enabled": false
    },
    {
      "name": "verify-signature",
      "description": "Verify the Authenticode signature of a build that was put in the transfer folder.",
      "executable": "C:\\Program Files (x86)\\Windows Kits\\10\\bin\\x64\\signtool.exe",
      "args": ["verify", "/pa", "{file}"],
      "params": {
        "file": { "type": "inbox_path", "extensions": [".exe", ".msi", ".dll"] }
      },
      "timeout_sec": 60,
      "enabled": false
    }
  ]
}
